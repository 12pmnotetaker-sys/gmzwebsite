---
import BaseLayout from '@layouts/BaseLayout.astro';
import PageHeader from '@components/PageHeader.astro';
import { claims, company, serviceRegionInline } from '@data/site';

/**
 * Note what this page does not say, because the omissions are the decisions.
 *
 * There is no "licensed and insured". `claims.licensedAndInsured` is false: the
 * CSLB number is settled and publishable on its own, the insurance half is not,
 * and no GMZ document states a carrier, a coverage amount or a bond. The
 * Working Document has a whole safety section citing workers compensation and
 * liability cover; none of it ships until someone who can be held to it says so.
 *
 * There are no biographies either. The Business Profile states four names and
 * four roles and nothing more, so this page states four names and four roles.
 * Inventing a paragraph of warmth about a real person is the easiest thing on
 * this site to do and the hardest to take back.
 */
const { people, license, memberships, drawings, address, heritage } = company;

/*
 * The generations line is a claim with one weak source, so `claims` decides
 * whether it is said at all. Without it the page still has the founding year,
 * which is confirmed, and "family-owned", which four names below make good on.
 */
const generational = claims.familyHeritage ? `A ${heritage.ordinal} generation family` : 'A family';
---

<BaseLayout
  title="About"
  description={`${generational} company on the San Francisco Peninsula, landscaping from a ${address.locality} yard since ${company.founded}.`}
>
  <PageHeader
    eyebrow="Who we are"
    title="About"
    lede="A family company, working one region, with the same people carrying a garden from the first sketch to the fiftieth visit."
  />

  <div class="container">
    <section class="section story" aria-labelledby="story-title">
      <div class="section-head">
        <div>
          <p class="kicker">The company</p>
          <h2 class="section-title" id="story-title">
            Family-owned. Rooted in the Peninsula since {company.founded}.
          </h2>
        </div>
      </div>

      <div class="prose story__body">
        <p>
          {company.founder} founded {company.name} in {company.founded}. Based in
          {address.locality}, we are a family-owned landscape design, construction and maintenance
          company serving {serviceRegionInline}.
          {
            claims.familyHeritage && (
              <>
                {' '}
                Our family's landscaping experience began in {heritage.tradeSince} and now spans{' '}
                {heritage.generations} generations.
              </>
            )
          }
        </p>
        <p>
          Family members are directly involved in design, project management and maintenance. We
          work with clients to understand how they use their property, plan the improvements they
          need, and coordinate the work from the initial design through installation and ongoing
          care.
        </p>
        <p>
          Our work includes planting, patios, paths, retaining walls, irrigation, drainage and
          landscape lighting. We take on complete garden renovations as well as improvements to
          individual areas, and we can build from plans prepared by other landscape designers.
          Maintenance is also available for established gardens, whether we installed them or not.
        </p>
        <p>
          Working locally helps us plan for the conditions that affect Peninsula gardens: sun and
          shade, slopes, soil, drainage and seasonal water needs. We consider these details
          alongside the way you want to use the space and the care it will need over time.
        </p>
      </div>
    </section>

    <section class="section people" aria-labelledby="people-title">
      <div class="section-head">
        <div>
          <p class="kicker">Our team</p>
          <h2 class="section-title" id="people-title">Meet the Gomez family.</h2>
        </div>
      </div>

      <ul class="roster">
        {
          people.map((person) => (
            <li class="person">
              <h3 class="person__name">{person.name}</h3>
              <p class="person__role">{person.role}</p>
            </li>
          ))
        }
      </ul>
    </section>

    <section class="section how" aria-labelledby="how-title">
      <div class="section-head">
        <div>
          <p class="kicker">How it is put together</p>
          <h2 class="section-title" id="how-title">Design, build and care are one company.</h2>
        </div>
      </div>

      <div class="prose how__body">
        <p>
          Drawings are made {drawings.toLowerCase()} rather than bought in, which is the reason the design
          and the build agree with each other. A plan drawn by someone who will never have to set the
          grade tends to be a plan that changes on site, and a plan that changes on site is how a budget
          moves.
        </p>
        <p>
          The same company then comes back. That is the part that decides whether a garden still
          looks like the drawing in five years, and it is why maintenance is a service here rather
          than a handover.
        </p>
        <p>
          <a class="link-accent" href="/process">How a job actually runs</a>, step by step, is
          written out in full.
        </p>
      </div>
    </section>

    <section class="section checks" aria-labelledby="checks-title">
      <div class="section-head">
        <div>
          <p class="kicker">The things worth checking</p>
          <h2 class="section-title" id="checks-title">On the record.</h2>
        </div>
      </div>

      <dl class="facts">
        <div class="facts__row facts__row--inline">
          <dt>Trading</dt>
          <dd>Since {company.founded}, as {company.legalName}</dd>
        </div>
        <div class="facts__row facts__row--inline">
          <dt>Based</dt>
          <dd>{address.locality}, California</dd>
        </div>
        <div class="facts__row facts__row--inline">
          <dt>Working</dt>
          <dd>
            {company.serviceRegion}. <a href="/where-we-work">The towns, and what each requires</a>.
          </dd>
        </div>
        <div class="facts__row facts__row--inline">
          <dt>{license.label}</dt>
          <dd>
            #{license.number}. Verifiable on the California State License Board's public register.
          </dd>
        </div>
        <div class="facts__row facts__row--inline">
          <dt>Drawings</dt>
          <dd>{drawings}</dd>
        </div>
        {
          memberships.map((body) => (
            <div class="facts__row facts__row--inline">
              <dt>Member</dt>
              <dd>
                {body.name} ({body.abbr})
              </dd>
            </div>
          ))
        }
      </dl>
    </section>
  </div>
</BaseLayout>

<style>
  .story__body,
  .how__body {
    margin-block-start: var(--space-lg);
  }

  .roster {
    list-style: none;
    margin: var(--space-lg) 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: var(--space-lg);
  }

  .person {
    border-block-start: 2px solid var(--color-structure);
    padding-block-start: 0.875rem;
  }

  .person__name {
    margin: 0;
    font-size: var(--text-lg);
    letter-spacing: var(--tracking-heading);
  }

  .person__role {
    margin-block-start: 0.25rem;
    color: var(--color-text-muted);
  }

  .checks {
    padding-block-end: var(--space-3xl);
  }

  .checks .facts {
    margin-block-start: var(--space-lg);
    max-inline-size: var(--width-prose);
  }

  @media (width < 980px) {
    .roster {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (width < 560px) {
    .roster {
      grid-template-columns: 1fr;
      gap: var(--space-md);
    }
  }
</style>
