---
/**
 * The garden landing: the screen a weekly maintenance client arrives at.
 *
 * One question, one answer: when is the next visit. That date is the largest
 * thing on the screen. Everything else is secondary, in reading order: what
 * was done last visit, the service and past visits, the plants on record, the
 * seasonal offer, documents, and one button.
 *
 * On desktop the next-visit panel moves to the rail, which is
 * why they render twice: once in the column with `column-only`, once in the
 * rail. The steps are the same; there is just room beside them.
 *
 * This is the one garden screen that renders for a client whose record is
 * not written yet. It says so, with the phone number, rather than showing
 * somebody else's garden.
 */
import PortalLayout from '@layouts/PortalLayout.astro';
import ScreenHead from '@components/portal/ScreenHead.astro';
import StatusChip from '@components/portal/StatusChip.astro';
import Row from '@components/portal/Row.astro';
import Plate from '@components/portal/Plate.astro';
import { routes } from '@data/portal/routes';
import { primaryPhone, portalHoursLine } from '@data/site';
import { landingPlants } from '../../../server/records';
import { gardenScreen } from '../../../server/screen';

export const prerender = false;

const screen = await gardenScreen(Astro, { allowMissing: true });
if (screen instanceof Response) return screen;
const { client, garden, plants } = screen;
const shortlist = landingPlants(plants);
---

{
  garden ? (
    <PortalLayout title="Your garden" footerTagline>
      <Plate caption={garden.display.photoCaption} height={170} bleed />

      <header class="head stack">
        <h1 class="kicker">{garden.display.kicker}</h1>
        <div class="rule-accent rule-mark" aria-hidden="true" />
      </header>

      {garden.offer && (
        <a class="offer-banner" href={routes.offer(garden.offer.slug)}>
          <span class="offer-banner__copy">
            <span class="offer-banner__kicker">{garden.offer.kicker}</span>
            <span class="offer-banner__title">{garden.offer.rowNote}</span>
          </span>
          <span class="offer-banner__action">
            View offer <span aria-hidden="true">&rarr;</span>
          </span>
        </a>
      )}

      <section class="panel panel--calm column-only" aria-labelledby="next-visit">
        <span class="kicker kicker--muted" id="next-visit">
          Next visit
        </span>
        <p class="answer">{garden.nextVisit.date}</p>
        <p class="body">{garden.nextVisit.window}</p>
        <StatusChip tone={garden.nextVisit.status} label={garden.nextVisit.statusLabel} />
      </section>

      <section class="block sect">
        <h2 class="kicker">{garden.lastVisit.kicker}</h2>
        <p class="body">{garden.lastVisit.summary}</p>
        <StatusChip tone={garden.lastVisit.status} label={garden.lastVisit.statusLabel} />
      </section>

      <nav class="block rows rows--open" aria-label="Your service">
        <Row href={routes.service} title="Your service" note={garden.service.rowNote} />
        <Row href={routes.visit} title="Past visits" note="What was done, visit by visit" />
      </nav>

      {shortlist.length > 0 && (
        <section class="block stack--md">
          <div class="sect">
            <h2 class="kicker">Plants in your garden</h2>
            <p class="note">
              The trees and plants we keep a record of, and what each one needs from us.
            </p>
          </div>
          <div class="rows">
            {shortlist.map((plant) => (
              <Row
                href={routes.plant(plant.slug)}
                title={plant.data.name}
                note={plant.data.landingNote ?? plant.data.summary}
                chip={plant.data.status.tone === 'done' ? undefined : plant.data.status}
              />
            ))}
          </div>
          <a class="link-action" href={routes.plants}>
            See every plant on record
          </a>
        </section>
      )}

      <nav class="block rows" aria-label="More">
        <Row href={routes.documents} title="Documents" note="Agreement, insurance, plans" />
      </nav>

      <div class="block block--end actions">
        <a class="btn btn--primary" href={routes.ask}>
          Ask for something
        </a>
      </div>

      <Fragment slot="rail">
        <section class="panel panel--calm" aria-label="Next visit">
          <span class="kicker kicker--muted">Next visit</span>
          <p class="answer">{garden.nextVisit.date}</p>
          <p class="body">{garden.nextVisit.window}</p>
          <StatusChip tone={garden.nextVisit.status} label={garden.nextVisit.statusLabel} />
        </section>
      </Fragment>
    </PortalLayout>
  ) : (
    <PortalLayout title="Your garden" footerTagline footerHours>
      <ScreenHead kicker={`${client.name}, your garden`} title="Your record is being set up" long>
        <p class="body">
          You are signed in, and your garden's record is still being written. It will show your
          visits, your plants and your documents here once it is.
        </p>
      </ScreenHead>
      <section class="block panel panel--calm" aria-labelledby="call-office">
        <span class="kicker kicker--muted" id="call-office">
          In the meantime, call the office
        </span>
        <a class="link-phone link-phone--answer" href={`tel:${primaryPhone.tel}`}>
          {primaryPhone.display}
        </a>
        <p class="note">{portalHoursLine}</p>
      </section>
    </PortalLayout>
  )
}

<style>
  .head {
    padding-block: var(--space-md);
  }

  .sect .chip {
    margin-block-start: var(--space-2xs);
  }

  .offer-banner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: var(--space-md);
    margin-block: var(--space-md) var(--space-lg);
    padding: var(--space-lg);
    background: var(--gmz-amber);
    color: var(--gmz-teal);
    text-decoration: none;
    border-radius: 6px;
  }
  .offer-banner__copy {
    display: grid;
    gap: var(--space-xs);
    flex: 1 1 260px;
  }
  .offer-banner__kicker {
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.07em;
    text-transform: uppercase;
  }
  .offer-banner__title {
    font-size: clamp(1.25rem, 2.3vw, 1.625rem);
    font-weight: 800;
    line-height: 1.25;
  }
  .offer-banner__action {
    padding: var(--space-sm) var(--space-md);
    background: var(--gmz-teal);
    color: var(--gmz-amber);
    font-weight: 700;
    white-space: nowrap;
    border-radius: 4px;
  }
  .offer-banner:hover .offer-banner__action {
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .offer-banner:focus-visible {
    outline: 3px solid var(--color-focus);
    outline-offset: 4px;
  }
</style>
