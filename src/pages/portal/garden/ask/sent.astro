---
/**
 * The garden client's receipt after "Ask for something". The receipt itself
 * is RequestSent; this page supplies the garden's chrome, its words and the
 * way back to the garden. There is no back link in the bar: the form is
 * behind this screen and there is nothing to return to.
 */
import PortalLayout from '@layouts/PortalLayout.astro';
import RequestSent from '@components/portal/RequestSent.astro';
import { routes } from '@data/portal/routes';
import { client, request } from '@data/portal/garden';
---

<PortalLayout title="Request sent" property={client.property} footerKicker="Something urgent">
  <RequestSent sent={request.sent} backHref={routes.garden} backLabel="Back to your garden" />
  <Fragment slot="rail">
    <RequestSent
      sent={request.sent}
      backHref={routes.garden}
      backLabel="Back to your garden"
      rail
    />
  </Fragment>
</PortalLayout>
