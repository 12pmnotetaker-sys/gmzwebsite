---
/**
 * Ask for something, from the garden.
 *
 * The form posts here. The request is kept, the office is told, and the
 * client is sent to the receipt for the reference they were given. If the
 * request could not be kept, the form comes back with what they typed and
 * the reason, and the phone number is right there.
 */
import PortalLayout from '@layouts/PortalLayout.astro';
import AskForm from '@components/portal/AskForm.astro';
import { company } from '@data/site';
import { routes } from '@data/portal/routes';
import { RequestRejected, createRequest } from '../../../../server/requests';
import { chosen, field, files, gardenScreen } from '../../../../server/screen';

export const prerender = false;

const screen = await gardenScreen(Astro, {});
if (screen instanceof Response) return screen;
const { client, garden } = screen;

let error: string | undefined;
let previous: { about?: string; what?: string } | undefined;

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const about = field(form, 'about', 60);
  const what = field(form, 'what');
  previous = { about, what };
  try {
    const { reference } = await createRequest(client, {
      kind: 'ask',
      about: chosen(garden.request.categories, about),
      body: what,
      photos: files(form, 'photos'),
    });
    return Astro.redirect(routes.asked(reference), 303);
  } catch (cause) {
    if (!(cause instanceof RequestRejected)) throw cause;
    console.error(cause.message);
    error =
      cause.reason === 'photo-too-large'
        ? 'One of the photos is too large to send. A photo straight from the phone is fine; a scan or a file over twelve megabytes is not.'
        : cause.reason === 'photo-unreadable'
          ? 'One of the files attached is not a photo we can read. Try another, or send without it.'
          : 'This did not reach us. Try once more, or call the office; nothing you typed is lost.';
  }
}
---

<PortalLayout
  title="Ask for something"
  property={garden.display.property}
  backHref={routes.garden}
  backLabel="Back"
  footerKicker={company.legalName}
>
  <AskForm
    kicker={`${garden.display.name}, ${garden.display.town}`}
    action={routes.ask}
    copy={garden.request}
    error={error}
    previous={previous}
  />

  <Fragment slot="rail">
    <AskForm rail copy={garden.request} />
  </Fragment>
</PortalLayout>
