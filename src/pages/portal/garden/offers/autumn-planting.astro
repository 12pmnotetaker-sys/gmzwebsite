---
/**
 * The autumn planting offer.
 *
 * The only screen in the portal that carries a price, and it works because it
 * is a fixed price for a fixed thing: cyclamen, a flat at a time, planted on
 * a normal Wednesday visit. The photo, the title and the price come first;
 * then the four things we need to know, in the order the crew needs them:
 * which colour, where, whether to pick the spot for them, and how many.
 *
 * There is no backend behind the form yet. The textarea and the photo input
 * carry no `name`, so nothing a person types is ever put in a URL; submitting
 * simply opens the request form, with JavaScript or without it. The radios do
 * carry a shared name, because that is what makes them a set, and a fixed
 * choice is not something a person typed.
 *
 * On desktop the total and the send block move to the rail, which is why
 * they render twice: once in the column with `column-only`, once in the rail.
 * Both send buttons submit the one form in the column by id.
 */
import PortalLayout from '@layouts/PortalLayout.astro';
import ScreenHead from '@components/portal/ScreenHead.astro';
import PhotoField from '@components/portal/PhotoField.astro';
import Plate from '@components/portal/Plate.astro';
import { routes } from '@data/portal/routes';
import { client, offer } from '@data/portal/garden';

const formId = 'offer-form';
const slug = (label: string) => label.toLowerCase().replace(/\s+/g, '-');

/**
 * The worked example the total describes, two flats of red: the first colour and
 * the second quantity.
 */
const chosenColour = offer.colours[0].label;
const chosenQuantity = offer.quantities[1];
---

<PortalLayout
  title={offer.rowTitle}
  property={client.property}
  backHref={routes.garden}
  backLabel="Back"
  footerKicker="Rather talk it through"
>
  <Plate caption="Cyclamen photo" height={190} bleed />

  <ScreenHead kicker={offer.kicker} title={offer.title} long>
    <p class="body">{offer.intro}</p>
  </ScreenHead>

  <section class="block block--tight panel panel--calm" aria-labelledby="price">
    <span class="kicker kicker--muted" id="price">{offer.priceKicker}</span>
    <p class="answer answer--figure">{offer.price}</p>
    <p class="body">{offer.includes}</p>
  </section>

  <form class="block stack stack--lg" id={formId} action={routes.ask} method="get">
    <fieldset class="group">
      <legend class="label">Colour</legend>
      <div class="choices">
        {
          offer.colours.map((colour) => (
            <label class="choice">
              <input
                type="radio"
                name="colour"
                value={slug(colour.label)}
                checked={colour.label === chosenColour}
              />
              {colour.swatch && (
                <span
                  class="choice__swatch"
                  style={`background:${colour.swatch}`}
                  aria-hidden="true"
                />
              )}
              <span>{colour.label}</span>
            </label>
          ))
        }
      </div>
    </fieldset>

    <div class="field">
      <label class="label" for="offer-where">Where they go</label>
      <textarea
        id="offer-where"
        rows="3"
        placeholder="The front beds either side of the path, and the two pots by the door"
      ></textarea>
      <p class="note">{offer.placeNote}</p>
    </div>

    <fieldset class="group">
      <legend class="label">Not sure where</legend>
      <label class="choice choice--wide">
        <input type="checkbox" />
        <span>{offer.recommendLabel}</span>
        <span class="choice__plus" aria-hidden="true">+</span>
      </label>
      <p class="note">{offer.recommendNote}</p>
    </fieldset>

    <fieldset class="group">
      <legend class="label">A photo of the spot, if it helps</legend>
      <PhotoField name="spot" height={140} />
    </fieldset>

    <fieldset class="group">
      <legend class="label">How many flats</legend>
      <div class="choices">
        {
          offer.quantities.map((quantity) => (
            <label class="choice">
              <input
                type="radio"
                name="flats"
                value={slug(quantity)}
                checked={quantity === chosenQuantity}
              />
              <span>{quantity}</span>
            </label>
          ))
        }
      </div>
      <p class="note">{offer.quantityNote}</p>
    </fieldset>
  </form>

  <section class="block panel panel--attention column-only" aria-labelledby="total">
    <span class="kicker" id="total">{offer.total.kicker}</span>
    <p class="sub">{offer.total.line}</p>
    <p class="body">{offer.total.body}</p>
  </section>

  <div class="block block--end actions column-only">
    <button class="btn btn--primary" type="submit" form={formId}>Send this request</button>
    <a class="btn btn--secondary" href={routes.ask}>Ask how many I need</a>
    <p class="note">{offer.disclaimer}</p>
  </div>

  <Fragment slot="rail">
    <section class="panel panel--attention" aria-label={offer.total.kicker}>
      <span class="kicker">{offer.total.kicker}</span>
      <p class="sub">{offer.total.line}</p>
      <p class="body">{offer.total.body}</p>
    </section>
    <div class="actions">
      <button class="btn btn--primary" type="submit" form={formId}>Send this request</button>
      <a class="btn btn--secondary" href={routes.ask}>Ask how many I need</a>
      <p class="note">{offer.disclaimer}</p>
    </div>
  </Fragment>
</PortalLayout>

<style>
  /* A fieldset is the right element for a set of choices; the browser's box
     around it is not. The min-width reset is what lets the chips wrap on a
     narrow phone. */
  .group {
    margin: 0;
    padding: 0;
    border: 0;
    min-inline-size: 0;
  }

  .group > legend {
    padding: 0 0 var(--space-xs);
  }

  /* The note under a set of choices keeps the same 8 the field keeps under
     its textarea. */
  .group > .note {
    margin-block-start: var(--space-xs);
  }
</style>
