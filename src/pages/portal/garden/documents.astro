---
/**
 * Documents: everything on file for the garden. A row opens a screen in the
 * portal, opens a file from private storage, or says "To come".
 */
import PortalLayout from '@layouts/PortalLayout.astro';
import ScreenHead from '@components/portal/ScreenHead.astro';
import Row from '@components/portal/Row.astro';
import { routes } from '@data/portal/routes';
import { gardenScreen } from '../../../server/screen';

export const prerender = false;

const screen = await gardenScreen(Astro, {});
if (screen instanceof Response) return screen;
const { garden } = screen;

const hrefFor = (index: number) => {
  const doc = garden.documents[index]!;
  if (doc.route) return doc.route;
  if (doc.path) return routes.document(index);
  return undefined;
};
---

<PortalLayout
  title="Documents"
  property={garden.display.property}
  backHref={routes.garden}
  backLabel="Back"
  footerKicker=""
  footerTagline
>
  <ScreenHead kicker={`${garden.display.name}, ${garden.display.town}`} title="Documents" long>
    <p class="body note--lead">
      Everything on file for your garden. Each one opens as the document itself, and downloads.
    </p>
  </ScreenHead>

  <nav class="block rows" aria-label="Documents on file">
    {
      garden.documents.map((doc, index) => (
        <Row
          href={hrefFor(index)}
          title={doc.title}
          note={doc.note}
          action={hrefFor(index) ? 'Open' : 'To come'}
        />
      ))
    }
  </nav>

  <section class="block panel panel--calm column-only" aria-labelledby="need-more">
    <span class="kicker kicker--muted" id="need-more">{garden.documentsAsk.kicker}</span>
    <p class="body">{garden.documentsAsk.body}</p>
    <a class="link-action" href={routes.ask}>{garden.documentsAsk.link}</a>
  </section>

  <Fragment slot="rail">
    <section class="panel panel--calm" aria-label={garden.documentsAsk.kicker}>
      <span class="kicker kicker--muted">{garden.documentsAsk.kicker}</span>
      <p class="body">{garden.documentsAsk.body}</p>
      <a class="link-action" href={routes.ask}>{garden.documentsAsk.link}</a>
    </section>
  </Fragment>
</PortalLayout>

<style>
  /* The intro under the heading is body size in the muted ink. The same
     page-scoped rule as sign-in; once a third screen opens this way it belongs
     in portal.css as a shared body variant, and both pages drop their copy. */
  .note--lead {
    color: var(--color-text-muted);
  }
</style>
