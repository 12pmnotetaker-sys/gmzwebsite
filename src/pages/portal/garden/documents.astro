---
/**
 * Documents: everything on file for the garden.
 *
 * One row per document. A row with a document behind it opens the document;
 * one without says "To come" and is not a link, because a shelf that opens
 * itself is worse than one that admits the gap. The list is the data
 * module's, so a document added to the record appears here without touching
 * the page.
 *
 * On desktop the "need something that is not here" panel moves to the rail,
 * which is why it renders twice: once in the column with `column-only`, once
 * in the rail. The steps are the same; there is just room beside them.
 */
import PortalLayout from '@layouts/PortalLayout.astro';
import ScreenHead from '@components/portal/ScreenHead.astro';
import Row from '@components/portal/Row.astro';
import { routes } from '@data/portal/routes';
import { client, documents, documentsAsk } from '@data/portal/garden';
---

<PortalLayout
  title="Documents"
  property={client.property}
  backHref={routes.garden}
  backLabel="Back"
  footerKicker=""
  footerTagline
>
  <ScreenHead kicker={`${client.name}, ${client.town}`} title="Documents" long>
    <p class="body note--lead">
      Everything on file for your garden. Each one opens as the document itself, and downloads.
    </p>
  </ScreenHead>

  <nav class="block rows" aria-label="Documents on file">
    {
      documents.map((doc) => (
        <Row
          href={doc.href}
          title={doc.title}
          note={doc.note}
          action={doc.href ? 'Open' : 'To come'}
        />
      ))
    }
  </nav>

  <section class="block panel panel--calm column-only" aria-labelledby="need-more">
    <span class="kicker kicker--muted" id="need-more">{documentsAsk.kicker}</span>
    <p class="body">{documentsAsk.body}</p>
    <a class="link-action" href={routes.ask}>{documentsAsk.link}</a>
  </section>

  <Fragment slot="rail">
    <section class="panel panel--calm" aria-label={documentsAsk.kicker}>
      <span class="kicker kicker--muted">{documentsAsk.kicker}</span>
      <p class="body">{documentsAsk.body}</p>
      <a class="link-action" href={routes.ask}>{documentsAsk.link}</a>
    </section>
  </Fragment>
</PortalLayout>

<style>
  /* The intro under the heading is body size in the muted ink. The same
     page-scoped rule as sign-in; once a third screen opens this way it belongs
     in portal.css as a shared body variant, and both pages drop their copy. */
  .note--lead {
    color: var(--color-text-muted);
  }
</style>
