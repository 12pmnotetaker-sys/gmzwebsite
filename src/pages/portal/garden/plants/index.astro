---
/**
 * Plants in your garden: every plant on the record, flagged ones first.
 */
import PortalLayout from '@layouts/PortalLayout.astro';
import ScreenHead from '@components/portal/ScreenHead.astro';
import StatusChip from '@components/portal/StatusChip.astro';
import Row from '@components/portal/Row.astro';
import { routes } from '@data/portal/routes';
import { flaggedPlants } from '../../../../server/records';
import { gardenScreen } from '../../../../server/screen';

export const prerender = false;

const screen = await gardenScreen(Astro, {});
if (screen instanceof Response) return screen;
const { garden, plants } = screen;
const waiting = flaggedPlants(plants).length > 0;
---

<PortalLayout
  title="Plants in your garden"
  property={garden.display.property}
  backHref={routes.garden}
  footerKicker=""
>
  <ScreenHead
    kicker={`${garden.display.name}, ${garden.display.town}`}
    title="Plants in your garden"
    long
  />

  {
    waiting && (
      <section
        class="block block--tight panel panel--attention column-only"
        aria-labelledby="waiting-on-you"
      >
        <span class="kicker" id="waiting-on-you">
          {garden.plantsWaiting.kicker}
        </span>
        <p class="sub">{garden.plantsWaiting.headline}</p>
        <p class="body">{garden.plantsWaiting.body}</p>
      </section>
    )
  }

  {
    plants.length === 0 ? (
      <section class="block sect">
        <h2 class="kicker">Nothing on record yet</h2>
        <p class="body">
          The crew adds each plant as they get to know your garden. Ask about any plant and it goes
          on the record.
        </p>
      </section>
    ) : (
      <div class="block rows plants">
        {plants.map((plant) =>
          plant.data.flag ? (
            <a class="row row--stack" href={routes.plant(plant.slug)}>
              <span class="row__head">
                <span class="row__text">
                  <span class="row__title">{plant.data.listName ?? plant.data.name}</span>
                  <span class="row__note">{plant.data.species}</span>
                </span>
                <StatusChip tone={plant.data.status.tone} label={plant.data.status.label} />
              </span>
              <p class="body">{plant.data.flag.recommendation}</p>
              <span class="link-action link-action--sm">
                {plant.data.flag.action} <span aria-hidden="true">&rsaquo;</span>
              </span>
            </a>
          ) : (
            <Row
              href={routes.plant(plant.slug)}
              title={plant.data.listName ?? plant.data.name}
              note={plant.data.species}
              chip={plant.data.status}
            />
          ),
        )}
      </div>
    )
  }

  <div class="block block--end actions column-only">
    <a class="btn btn--secondary" href={routes.ask}>Ask about a plant</a>
  </div>

  <Fragment slot="rail">
    {
      waiting && (
        <section class="panel panel--attention" aria-label="Waiting on you">
          <span class="kicker">{garden.plantsWaiting.kicker}</span>
          <p class="sub">{garden.plantsWaiting.headline}</p>
          <p class="body">{garden.plantsWaiting.bodyRail}</p>
        </section>
      )
    }
    <a class="btn btn--secondary" href={routes.ask}>Ask about a plant</a>
  </Fragment>
</PortalLayout>

<style>
  /* On a list row the species is the row note under the name, in italic,
     whether the row is stacked for a decision or plain. */
  .plants :global(.row__note) {
    font-style: italic;
  }
</style>
