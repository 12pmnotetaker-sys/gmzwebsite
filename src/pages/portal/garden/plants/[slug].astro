---
/**
 * One plant's record: where it is, what it needs, what the crew has done,
 * what they have flagged, and their notes. The screen no competitor has.
 *
 * Every field is optional except the ones that make it a record. Where the
 * record gives no care history, none is shown rather than invented.
 */
import PortalLayout from '@layouts/PortalLayout.astro';
import ScreenHead from '@components/portal/ScreenHead.astro';
import Facts from '@components/portal/Facts.astro';
import Row from '@components/portal/Row.astro';
import Plate from '@components/portal/Plate.astro';
import { routes } from '@data/portal/routes';
import type { StatusKey } from '@data/portal/status';
import { signedUrl } from '../../../../server/db';
import { gardenScreen } from '../../../../server/screen';

export const prerender = false;

const screen = await gardenScreen(Astro, {});
if (screen instanceof Response) return screen;
const { garden, plants } = screen;

const plant = plants.find((entry) => entry.slug === Astro.params.slug);
if (!plant) return Astro.redirect(routes.plants, 302);
const { data } = plant;
const others = plants.filter((entry) => entry.slug !== plant.slug);
const photoSrc = data.photo?.path ? await signedUrl(data.photo.path) : undefined;

interface Fact {
  label: string;
  value?: string;
  chip?: { tone: StatusKey; label: string };
}

const facts: Fact[] = [{ label: 'Where', value: data.where }];
if (data.onRecordSince) facts.push({ label: 'On record since', value: data.onRecordSince });
if (data.water) facts.push({ label: 'Water', value: data.water });
if (data.condition) facts.push({ label: 'Condition', chip: data.condition });
if (data.protectedTree) {
  facts.push({ label: 'Protected', value: data.protectedTree.jurisdiction });
  facts.push({ label: 'Permit', value: data.protectedTree.permit });
}

const hasRail = Boolean(data.protectedTree || data.flag);
---

<PortalLayout
  title={data.name}
  property={garden.display.property}
  backHref={routes.plants}
  backLabel="Back"
  footerKicker="Questions about a plant"
>
  <ScreenHead kicker={`Your garden, ${garden.display.town}`} title={data.name} long>
    <span class="species">{data.species}</span>
  </ScreenHead>

  {
    data.photo && (
      <div class="block--tight">
        <Plate caption={data.photo.caption} alt={data.photo.alt} src={photoSrc} height={200} tall />
      </div>
    )
  }

  <div class="block">
    <Facts rows={facts} />
  </div>

  {
    data.protectedTree && (
      <section
        class="block--tight panel panel--attention column-only"
        aria-labelledby="protected-tree"
      >
        <span class="kicker" id="protected-tree">
          Protected tree
        </span>
        <p class="sub">{data.protectedTree.headline}</p>
        <p class="body">{data.protectedTree.body}</p>
      </section>
    )
  }

  {
    data.flag && (
      <div class="block--tight stack stack--md column-only">
        <section class="panel panel--attention" aria-labelledby="waiting-on-you">
          <span class="kicker" id="waiting-on-you">
            Waiting on you
          </span>
          <p class="sub">{data.flag.action}</p>
          <p class="body">{data.flag.recommendation}</p>
        </section>
        <div class="actions">
          <a class="btn btn--secondary" href={routes.ask}>
            Ask about this plant
          </a>
        </div>
      </div>
    )
  }

  {
    data.careHistory && data.careHistory.length > 0 && (
      <section class="block stack stack--md" aria-labelledby="care-history">
        <div class="sect">
          <h2 class="kicker" id="care-history">
            Care history
          </h2>
        </div>
        <div class="steps">
          {data.careHistory.map((entry) => (
            <div class="step">
              <span class="step__when">{entry.when}</span>
              <p class="note">{entry.what}</p>
            </div>
          ))}
        </div>
      </section>
    )
  }

  {
    data.notes.length > 0 && (
      <section class="block stack stack--md" aria-labelledby="crew-notes">
        <div class="sect">
          <h2 class="kicker" id="crew-notes">
            Notes from the crew
          </h2>
        </div>
        <div class="notes">
          {data.notes.map((paragraph) => (
            <p>{paragraph}</p>
          ))}
        </div>
      </section>
    )
  }

  {
    others.length > 0 && (
      <section class="block block--end stack stack--md" aria-labelledby="also-on-record">
        <div class="sect">
          <h2 class="kicker" id="also-on-record">
            Also on record
          </h2>
        </div>
        <div class="rows">
          {others.map((other) => (
            <Row
              href={routes.plant(other.slug)}
              title={other.data.name}
              note={other.data.summary}
              chip={other.data.status.tone === 'done' ? undefined : other.data.status}
            />
          ))}
        </div>
      </section>
    )
  }

  {
    hasRail && (
      <Fragment slot="rail">
        {data.protectedTree && (
          <section class="panel panel--attention" aria-label="Protected tree">
            <span class="kicker">Protected tree</span>
            <p class="sub">{data.protectedTree.headline}</p>
            <p class="body">{data.protectedTree.body}</p>
          </section>
        )}
        {data.flag && (
          <section class="panel panel--attention" aria-label="Waiting on you">
            <span class="kicker">Waiting on you</span>
            <p class="sub">{data.flag.action}</p>
            <p class="body">{data.flag.recommendation}</p>
          </section>
        )}
        {data.flag && (
          <a class="btn btn--secondary" href={routes.ask}>
            Ask about this plant
          </a>
        )}
      </Fragment>
    )
  }
</PortalLayout>

<style>
  .steps {
    display: flex;
    flex-direction: column;
  }

  /* The crew's notes come from Markdown, so the paragraphs are styled here
     rather than by class: the body size, 13 apart. */
  .notes {
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
  }

  .notes :global(p) {
    margin: 0;
    font-size: var(--text-base);
    line-height: 1.55;
    color: var(--color-text);
  }
</style>
