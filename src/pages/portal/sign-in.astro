---
/**
 * Sign in. One screen for everyone GMZ gives an account to: a client's
 * garden or project, an Admin's operations workspace, a Staff member's field
 * desk.
 *
 * Two ways in for a client. Most type their address and get a link; accounts
 * that hold more than one property have a password as well, and the password
 * field is there for them. Leaving it empty asks for a link, which is the
 * right default because anyone arriving here from a bookmark has forgotten
 * it. Admin and Staff always have a password; there is no emailed link for
 * either.
 *
 * The screen has states rather than pages. After a link is asked for it says
 * so, with the address it went to; after a wrong password it says that,
 * without saying which of the three accounts it checked; when the portal has
 * no database or no mail it says that too, with the phone number, rather
 * than pretending. Every state is a redirect back to this route, so a
 * refresh never re-sends anything and nothing typed lands in a URL.
 */
import PortalLayout from '@layouts/PortalLayout.astro';
import ScreenHead from '@components/portal/ScreenHead.astro';
import StatusChip from '@components/portal/StatusChip.astro';
import { routes } from '@data/portal/routes';
import { status } from '@data/portal/status';
import { primaryPhone, portalHoursLine } from '@data/site';
import {
  createSession,
  issueSignInLink,
  landingFor,
  maskEmail,
  setNotice,
  setSessionCookie,
  signInWithPassword,
  takeNotice,
} from '../../server/auth';
import { mailConfigured, portalConfigured } from '../../server/env';
import {
  ADMIN_COOKIE,
  authenticateAdmin,
  passwordClient,
} from '../../server/operations-admin/auth';
import {
  STAFF_COOKIE,
  createSession as createStaffSession,
  readSession as readStaffSession,
  setSessionCookie as setStaffCookie,
  signInWithPassword as signInStaffWithPassword,
} from '../../server/staff/auth';

export const prerender = false;

const configured = portalConfigured();

/**
 * One sign-in screen for the whole site: a client's garden or project, an
 * Admin's operations workspace, or a Staff member's field desk. Which one is
 * decided entirely by which account the typed email and password match, in
 * that order, and never announced: the mismatch copy below is the same
 * whichever system the typed address actually belongs to, or none.
 */
async function alreadySignedIn(): Promise<string | null> {
  if (Astro.locals.client) return landingFor(Astro.locals.client);
  try {
    if (await authenticateAdmin(Astro.cookies.get(ADMIN_COOKIE)?.value)) return '/admin/operations';
  } catch {
    /* Admin not configured; a client or staff session can still be checked. */
  }
  try {
    if (await readStaffSession(Astro.cookies.get(STAFF_COOKIE)?.value)) return '/staff/operations';
  } catch {
    /* Staff not configured; fall through to the sign-in form. */
  }
  return null;
}

// Already in. There is nothing on this screen for them.
const landed = await alreadySignedIn();
if (landed) return Astro.redirect(landed, 302);

if (Astro.request.method === 'POST' && configured) {
  const form = await Astro.request.formData();
  const email = String(form.get('email') ?? '')
    .trim()
    .slice(0, 200);
  const password = String(form.get('password') ?? '');

  if (email && password) {
    try {
      const { data, error } = await passwordClient().auth.signInWithPassword({ email, password });
      const admin =
        !error && data.session ? await authenticateAdmin(data.session.access_token) : null;
      if (admin && data.session) {
        Astro.cookies.set(ADMIN_COOKIE, data.session.access_token, {
          httpOnly: true,
          secure: Astro.url.protocol === 'https:',
          sameSite: 'strict',
          path: '/',
          maxAge: Math.min(data.session.expires_in, 3600),
        });
        return Astro.redirect('/admin/operations', 303);
      }
    } catch {
      /* Admin sign-in unavailable; a staff or client account can still match. */
    }

    const staffMember = await signInStaffWithPassword(email, password);
    if (staffMember) {
      setStaffCookie(Astro.cookies, Astro.url, await createStaffSession(staffMember.id));
      return Astro.redirect('/staff/operations', 303);
    }

    const client = await signInWithPassword(email, password);
    if (client) {
      setSessionCookie(Astro.cookies, Astro.url, await createSession(client.id));
      return Astro.redirect(landingFor(client), 303);
    }
    return Astro.redirect(`${routes.signIn}?state=mismatch`, 303);
  }

  if (email) {
    await issueSignInLink(email, Astro.url.origin);
    setNotice(Astro.cookies, Astro.url, { kind: 'link-sent', masked: maskEmail(email) });
    return Astro.redirect(routes.signIn, 303);
  }
  return Astro.redirect(`${routes.signIn}?state=empty`, 303);
}

const notice = takeNotice(Astro.cookies, Astro.url);
const query = Astro.url.searchParams.get('state');

type State = 'form' | 'sent' | 'mismatch' | 'empty' | 'off' | 'nomail' | 'signed-out';
let state: State = 'form';
if (!configured) state = 'off';
else if (notice?.kind === 'link-sent') state = 'sent';
else if (notice?.kind === 'signed-out') state = 'signed-out';
else if (query === 'mismatch') state = 'mismatch';
else if (query === 'empty') state = 'empty';
else if (!mailConfigured()) state = 'nomail';

const showForm = state !== 'off' && state !== 'sent';
const hasError = state === 'mismatch' || state === 'empty' || state === 'nomail';
---

<PortalLayout title="Sign in" footerTagline footerHours={state === 'off' || state === 'nomail'}>
  {
    state === 'sent' ? (
      <>
        <h1 class="visually-hidden">A link is on its way</h1>
        <section class="block panel panel--done" aria-labelledby="link-sent">
          <span class="kicker kicker--muted" id="link-sent">
            Check your email
          </span>
          <p class="answer">A link is on its way</p>
          <p class="body">
            If {notice?.masked} is on file with us, a link to your portal arrives in a minute or
            two. It stays live for seven days.
          </p>
          <StatusChip tone={status.done.key} label={status.done.label} />
        </section>
        <section class="block sect">
          <h2 class="kicker">Nothing arrived</h2>
          <p class="body">
            Check the address, and the folder your email keeps things it is unsure about.
          </p>
          <a class="link-action" href={routes.signIn}>
            Try a different address
          </a>
        </section>
      </>
    ) : state === 'off' ? (
      <ScreenHead kicker="Sign in" title="The portal is not switched on yet" long>
        <p class="body note--lead">
          Your garden and your documents are safe; the screens that show them are not open yet. Call
          the office and we will read you anything the portal would show you.
        </p>
      </ScreenHead>
    ) : (
      <ScreenHead kicker="Sign in" title="Sign in" long>
        <p class="body note--lead">
          Type the email address we have for you and we will send a link to your garden or project.
          Accounts that hold more than one property, and every Admin or Staff account, sign in with
          a password instead.
        </p>
      </ScreenHead>
    )
  }

  {
    state === 'signed-out' && (
      <p class="block--tight note" role="status">
        You are signed out. Ask for a new link whenever you want back in.
      </p>
    )
  }

  {
    showForm && (
      <form class="block stack--lg signin" action={routes.signIn} method="post" data-astro-reload>
        {state === 'mismatch' && (
          <p class="field__error" role="alert" id="signin-error">
            That email and password do not match what we have, or there have been too many tries in
            a row. Leave the password empty and we will email you a link instead.
          </p>
        )}
        {state === 'empty' && (
          <p class="field__error" role="alert" id="signin-error">
            Type the email address we have for you.
          </p>
        )}
        {state === 'nomail' && (
          <p class="field__error" role="alert" id="signin-error">
            Links cannot be sent at the moment. Accounts with a password can still sign in; everyone
            else, call the office.
          </p>
        )}
        <div class="field">
          <label class="label" for="email">
            Email
          </label>
          <input
            id="email"
            name="email"
            type="email"
            autocomplete="username"
            placeholder="you@example.com"
            required
            aria-describedby={hasError ? 'signin-error' : undefined}
          />
        </div>
        <div class="field">
          <label class="label" for="password">
            Password, if you have one
          </label>
          <input id="password" name="password" type="password" autocomplete="current-password" />
          <p class="note">
            A client account without one can leave it empty for an emailed link. Admin and Staff
            always have one.
          </p>
        </div>
        <button class="btn btn--primary" type="submit">
          Sign in
        </button>
      </form>
    )
  }

  <section class="block block--xl sect">
    <h2 class="kicker">Trouble getting in</h2>
    <p class="body">Call the office and we will read you anything the portal would show you.</p>
    <a class="link-phone" href={`tel:${primaryPhone.tel}`}>{primaryPhone.display}</a>
    {(state === 'off' || state === 'nomail') && <p class="note">{portalHoursLine}</p>}
  </section>
</PortalLayout>

<style>
  .signin {
    display: flex;
    flex-direction: column;
  }

  .note--lead {
    color: var(--color-text-muted);
  }

  .block--xl {
    margin-block-start: var(--space-xl);
  }

  .sect .link-phone {
    margin-block-start: var(--space-2xs);
  }
</style>
