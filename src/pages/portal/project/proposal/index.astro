---
/**
 * The proposal in full: scope, the price with its allowance, the payment
 * schedule, and the statutory notices. Approved or not, it reads the same;
 * only the buttons and the stage bar change.
 */
import PortalLayout from '@layouts/PortalLayout.astro';
import ScreenHead from '@components/portal/ScreenHead.astro';
import StageBar from '@components/portal/StageBar.astro';
import Money from '@components/portal/Money.astro';
import Draws from '@components/portal/Draws.astro';
import NoticePages from '@components/portal/NoticePages.astro';
import { routes } from '@data/portal/routes';
import { signedUrl } from '../../../../server/db';
import { loadApproval } from '../../../../server/records';
import { projectScreen } from '../../../../server/screen';

export const prerender = false;

const screen = await projectScreen(Astro, {});
if (screen instanceof Response) return screen;
const { client, project } = screen;
const { proposal } = project;

const approval = await loadApproval(client, 'proposal');
const stage = approval ? project.stages.atApproved : project.stages.atProposal;
const noticesSrc = proposal.notices.path ? await signedUrl(proposal.notices.path) : undefined;
---

<PortalLayout
  title="Proposal"
  property={project.display.property}
  backHref={routes.project}
  backLabel="Back"
  footerLicence
>
  <ScreenHead
    kicker={`Proposal, ${project.display.name}, ${project.display.town}`}
    title={project.display.projectName}
    long
  >
    <p class="estimate-no">{proposal.estimateNo}</p>
  </ScreenHead>

  <div class="block column-only">
    <StageBar
      total={project.stages.total}
      done={stage.done}
      now={stage.now}
      caption={stage.caption}
    />
  </div>

  <section class="block stack stack--md scope">
    <div class="sect">
      <h2 class="kicker">What we will do</h2>
      <p class="body">{proposal.scope}</p>
    </div>
    <div class="stack stack--md">
      {proposal.scopeLines.map((line) => <p class="body scope__line">{line}</p>)}
    </div>
  </section>

  <section class="block stack stack--md">
    <div class="sect">
      <h2 class="kicker">The price</h2>
      <p class="sub">{proposal.priceLine}</p>
    </div>
    <Money lines={proposal.lines} total={proposal.total} />
    <section class="panel panel--calm" aria-labelledby="allowance">
      <span class="kicker kicker--muted" id="allowance">{proposal.allowance.kicker}</span>
      <p class="body">{proposal.allowance.why}</p>
      <p class="body">{proposal.allowance.effect}</p>
    </section>
  </section>

  <section class="block stack stack--md">
    <div class="sect">
      <h2 class="kicker">Payment schedule</h2>
      <p class="sub">{proposal.drawsHeadline}</p>
    </div>
    <Draws draws={proposal.draws} />
    <p class="note">{proposal.drawsNote}</p>
  </section>

  <section class="block stack stack--md">
    <div class="sect">
      <h2 class="kicker">{proposal.notices.kicker}</h2>
      <p class="body">{proposal.notices.body}</p>
    </div>
    <div class="well notices-well">
      <NoticePages src={noticesSrc} />
      {
        !noticesSrc && (
          <p class="note">
            The notices are shown as the document itself once it is on file. Until then this stands
            in for it and is not the legal text.
          </p>
        )
      }
    </div>
  </section>

  <div class="block block--end actions column-only">
    {
      approval ? (
        <a class="btn btn--primary" href={routes.approved}>
          What happens next
        </a>
      ) : (
        <a class="btn btn--primary" href={routes.confirm}>
          Review and approve
        </a>
      )
    }
    <a class="btn btn--secondary" href={routes.projectAsk}>Ask for a change</a>
  </div>

  <Fragment slot="rail">
    <StageBar
      total={project.stages.total}
      done={stage.done}
      now={stage.now}
      caption={stage.caption}
    />
    <section class="sect sect--rail" aria-labelledby="rail-price">
      <span class="kicker" id="rail-price">The price</span>
      <p class="sub">{proposal.priceLine}</p>
    </section>
    <div class="actions">
      {
        approval ? (
          <a class="btn btn--primary" href={routes.approved}>
            What happens next
          </a>
        ) : (
          <a class="btn btn--primary" href={routes.confirm}>
            Review and approve
          </a>
        )
      }
      <a class="btn btn--secondary" href={routes.projectAsk}>Ask for a change</a>
    </div>
  </Fragment>
</PortalLayout>

<style>
  /* "What we will do" sets its body a step further under the kicker than the
     other section heads do. */
  .scope .sect .body {
    margin-block-start: var(--space-2xs);
  }

  /* The scope, one claim per line, each set off by a 3px hairline on the
     left rather than a bullet. */
  .scope__line {
    padding-inline-start: var(--space-sm);
    border-inline-start: var(--rule-accent) solid var(--portal-hair);
  }

  /* NoticePages brings its own well, padded 18 around the page. The design
     note sits in the same well beneath it, so this outer well pads only the
     note's sides and foot, and the label pulls up through the inner well's
     bottom padding to sit 8 under the page, as the design has it. */
  .notices-well {
    padding-block-end: var(--space-md);
  }

  .notices-well > .label,
  .notices-well > .note {
    margin-inline: var(--space-md);
  }

  .notices-well > .label {
    display: block;
    margin-block-start: calc(var(--space-xs) - var(--space-md));
  }

  .notices-well > .note {
    margin-block-start: var(--space-xs);
    color: var(--color-text);
  }

  /* The rail's price head opens a little wider than the column's. */
  .sect--rail {
    gap: var(--space-xs);
  }
</style>
