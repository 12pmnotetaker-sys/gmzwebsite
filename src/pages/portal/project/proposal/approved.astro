---
/**
 * Approved. Calm, not celebratory. The recorded line is the real one: when
 * the approval was recorded and the name that was typed.
 */
import PortalLayout from '@layouts/PortalLayout.astro';
import StatusChip from '@components/portal/StatusChip.astro';
import StageBar from '@components/portal/StageBar.astro';
import { routes } from '@data/portal/routes';
import { status } from '@data/portal/status';
import { loadApproval, recordedLine } from '../../../../server/records';
import { projectScreen } from '../../../../server/screen';

export const prerender = false;

const screen = await projectScreen(Astro, {});
if (screen instanceof Response) return screen;
const { client, project } = screen;

const approval = await loadApproval(client, 'proposal');
if (!approval) return Astro.redirect(routes.confirm, 302);

const { approved, stages } = project;
const recorded = recordedLine(approval);
---

<PortalLayout
  title="Approved"
  property={project.display.property}
  footerKicker="Questions before you sign"
>
  {
    /* The one h1, always in the document: on desktop the panel below moves to the rail and is hidden from the column. */
  }
  <h1 class="visually-hidden">{approved.answer}</h1>
  <section class="panel panel--done block column-only" aria-labelledby="approved-project">
    <span class="kicker kicker--muted" id="approved-project">{project.display.projectName}</span>
    <p class="answer">{approved.answer}</p>
    <p class="body">{recorded}</p>
    <StatusChip tone={status.done.key} label={status.done.label} />
  </section>

  <div class="block column-only">
    <StageBar
      total={stages.total}
      done={stages.atApproved.done}
      now={stages.atApproved.now}
      caption={stages.atApproved.caption}
    />
  </div>

  <section class="block stack stack--md">
    <div class="sect">
      <h2 class="kicker">What happens next</h2>
    </div>
    <div class="steps">
      {
        approved.next.map((step) => (
          <div class="step">
            <span class="step__when">{step.when}</span>
            <p class="note">{step.what}</p>
          </div>
        ))
      }
    </div>
  </section>

  <div class="block block--end actions column-only">
    <a class="btn btn--secondary" href={routes.proposal}>See the proposal again</a>
  </div>

  <Fragment slot="rail">
    <section class="panel panel--done" aria-label={project.display.projectName}>
      <span class="kicker kicker--muted">{project.display.projectName}</span>
      <p class="answer">{approved.answer}</p>
      <p class="body">{recorded}</p>
      <StatusChip tone={status.done.key} label={status.done.label} />
    </section>
    <StageBar
      total={stages.total}
      done={stages.atApproved.done}
      now={stages.atApproved.now}
      caption={stages.atApproved.caption}
    />
    <a class="btn btn--secondary" href={routes.proposal}>See the proposal again</a>
  </Fragment>
</PortalLayout>

<style>
  .steps {
    display: flex;
    flex-direction: column;
  }
</style>
