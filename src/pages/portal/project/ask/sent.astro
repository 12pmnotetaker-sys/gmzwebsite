---
/**
 * The project client's receipt after "Ask for a change". The receipt itself
 * is RequestSent; this page supplies the project's chrome, the project's own
 * words and the way back to the project, so a client who asked about their
 * proposal is never shown another client's garden.
 */
import PortalLayout from '@layouts/PortalLayout.astro';
import RequestSent from '@components/portal/RequestSent.astro';
import { routes } from '@data/portal/routes';
import { client, requestSent } from '@data/portal/project';
---

<PortalLayout title="Request sent" property={client.property} footerKicker="Something urgent">
  <RequestSent sent={requestSent} backHref={routes.project} backLabel="Back to your project" />
  <Fragment slot="rail">
    <RequestSent
      sent={requestSent}
      backHref={routes.project}
      backLabel="Back to your project"
      rail
    />
  </Fragment>
</PortalLayout>
