---
/**
 * The expired link. A first-class screen, because it is the one that decides
 * whether a client gives up.
 *
 * Arriving from a link that has expired or been spent, the screen already
 * knows which address the link was for (the callback left a note, never a
 * URL) and offers to send a new one there in one tap. Arriving any other way,
 * it asks for the address. Either way the phone number is on the screen.
 */
import PortalLayout from '@layouts/PortalLayout.astro';
import ScreenHead from '@components/portal/ScreenHead.astro';
import { routes } from '@data/portal/routes';
import { primaryPhone, portalHoursLine } from '@data/site';
import {
  clientForToken,
  issueSignInLink,
  landingFor,
  maskEmail,
  setNotice,
  takeNotice,
} from '../../server/auth';
import { portalConfigured } from '../../server/env';

export const prerender = false;

if (Astro.locals.client) return Astro.redirect(landingFor(Astro.locals.client), 302);
if (!portalConfigured()) return Astro.redirect(routes.signIn, 302);

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const token = String(form.get('token') ?? '');
  const typed = String(form.get('email') ?? '')
    .trim()
    .slice(0, 200);

  // The expired link names its own address; a typed one is used only without it.
  const client = token ? await clientForToken(token) : null;
  const email = client?.email ?? typed;
  if (!email) return Astro.redirect(`${routes.linkExpired}?state=empty`, 303);

  const { outcome } = await issueSignInLink(email, Astro.url.origin);
  if (outcome === 'failed') return Astro.redirect(`${routes.signIn}?state=failed`, 303);
  setNotice(Astro.cookies, Astro.url, { kind: 'link-sent', masked: maskEmail(email) });
  return Astro.redirect(routes.signIn, 303);
}

const notice = takeNotice(Astro.cookies, Astro.url);
const known = notice?.kind === 'link-expired' && notice.masked && notice.token ? notice : null;
const empty = Astro.url.searchParams.get('state') === 'empty';
---

<PortalLayout title="Expired link" footerTagline>
  <ScreenHead kicker="Sign in" title="That link expired. We can send a new one." long>
    <p class="body">
      Links stay live for seven days, so an old email cannot open your account. Nothing is wrong
      with your account.
    </p>
  </ScreenHead>

  <form action={routes.linkExpired} method="post" novalidate>
    {
      empty && (
        <p class="block--tight field__error" role="alert" id="recover-error">
          Type the email address we have for you.
        </p>
      )
    }
    <div class="block field">
      <label class="label" for="recover">Send it to</label>
      {
        known ? (
          <>
            <input id="recover" type="text" value={known.masked} readonly aria-readonly="true" />
            <input type="hidden" name="token" value={known.token} />
            <a class="link-action link-action--sm" href={routes.signIn}>
              That is not my email
            </a>
          </>
        ) : (
          <input
            id="recover"
            name="email"
            type="email"
            autocomplete="email"
            placeholder="you@example.com"
            required
            aria-describedby={empty ? 'recover-error' : undefined}
          />
        )
      }
    </div>
    <div class="block stack--md">
      <button class="btn btn--amber" type="submit">Send me a new link</button>
      <p class="note">The new link arrives in a minute or two and lasts seven days.</p>
    </div>
  </form>

  <section class="block block--xl panel panel--calm call" aria-labelledby="call-office">
    <span class="kicker kicker--muted" id="call-office">Or call the office</span>
    <a class="link-phone link-phone--answer" href={`tel:${primaryPhone.tel}`}>
      {primaryPhone.display}
    </a>
    <p class="note">{portalHoursLine}</p>
  </section>
</PortalLayout>

<style>
  .block--xl {
    margin-block-start: var(--space-xl);
  }
</style>
