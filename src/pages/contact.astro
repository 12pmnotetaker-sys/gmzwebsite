---
import BaseLayout from '@layouts/BaseLayout.astro';
import PageHeader from '@components/PageHeader.astro';
import Placeholder from '@components/Placeholder.astro';
---

<BaseLayout title="Contact" description="Call, or send a note and we will come back to you.">
  <PageHeader
    eyebrow="Get in touch"
    title="Contact"
    lede="Call, or send a note and we will come back to you."
  />
  <Placeholder
    phase="Phase 2"
    what="The direct route for people who would rather call than fill in a form. Contact details already render in the footer on every page."
  />
</BaseLayout>
