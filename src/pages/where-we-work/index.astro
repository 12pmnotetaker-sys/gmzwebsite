---
import BaseLayout from '@layouts/BaseLayout.astro';
import PageHeader from '@components/PageHeader.astro';
import { company, fees } from '@data/site';
import { getPublishedTowns, townHref } from '@data/towns';

const towns = await getPublishedTowns();
const published = new Map(towns.map((town) => [town.data.name, town]));
---

<BaseLayout
  title="Where we work"
  description={`Landscape design, build and maintenance across ${company.serviceRegion}.`}
>
  <PageHeader
    eyebrow="Service area"
    title="Where we work"
    lede={`${company.serviceRegion}, worked from the Redwood City yard.`}
  />

  <div class="container">
    <p class="lead towns__intro">
      Every town on this list is reached from one yard, so the people who draw a garden are the
      people who build it and the people who come back to look after it. Where a town has
      requirements worth knowing before design starts, there is a page for it.
    </p>

    <ul class="towns">
      {
        company.serviceArea.map((name) => {
          const town = published.get(name);
          return (
            <li>
              {town ? (
                <a class="towns__link" href={townHref(town)}>
                  {name}
                </a>
              ) : (
                <span class="towns__plain">{name}</span>
              )}
            </li>
          );
        })
      }
    </ul>

    <p class="towns__note">
      Outside these towns an accommodation can be made on request. The travel charge is {
        fees.travel.display
      }, {fees.travel.note}.
    </p>
  </div>
</BaseLayout>

<style>
  .towns__intro {
    max-inline-size: var(--width-prose);
  }

  .towns {
    list-style: none;
    margin-block: var(--space-lg) 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5625rem;
  }

  .towns__link,
  .towns__plain {
    display: block;
    border: 1px solid var(--color-border-strong);
    background: var(--color-bg-subtle);
    padding: 0.5625rem 0.9375rem;
  }

  .towns__plain {
    color: var(--color-text-muted);
  }

  .towns__note {
    margin-block-start: var(--space-lg);
    max-inline-size: var(--width-prose);
    color: var(--color-text-muted);
  }
</style>
