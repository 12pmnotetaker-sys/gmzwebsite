---
import type { GetStaticPaths } from 'astro';
import { render } from 'astro:content';
import BaseLayout from '@layouts/BaseLayout.astro';
import PageHeader from '@components/PageHeader.astro';
import { formatUpdated, getPublishedArticles } from '@data/articles';

export const getStaticPaths = (async () => {
  const articles = await getPublishedArticles();
  return articles.map((article) => ({ params: { slug: article.id }, props: { article } }));
}) satisfies GetStaticPaths;

const { article } = Astro.props;
const { Content } = await render(article);
---

<BaseLayout
  title={article.data.title}
  description={article.data.seo?.description ?? article.data.lede}
>
  <PageHeader eyebrow="Answers" title={article.data.title} lede={article.data.lede} />

  <div class="container">
    <article class="prose article">
      <Content />
    </article>

    {
      article.data.advisory && (
        <aside class="advisory" aria-label="About this article">
          <p>
            General information, not advice for a specific property. Codes change and every town
            applies them differently; the authority on your project is the department that will
            review it.
          </p>
        </aside>
      )
    }

    <footer class="article-meta">
      <p class="article-meta__date">
        Checked against its sources on {formatUpdated(article.data.updated)}.
      </p>
      <h2 class="article-meta__title">Sources</h2>
      <ul class="article-meta__sources">
        {
          article.data.sources.map((source) => (
            <li>
              <a href={source.href} rel="noopener noreferrer" target="_blank">
                {source.label}
              </a>
            </li>
          ))
        }
      </ul>
    </footer>
  </div>
</BaseLayout>

<style>
  .article {
    max-inline-size: var(--width-prose);
  }

  .advisory {
    max-inline-size: var(--width-prose);
    margin-block-start: var(--space-lg);
    border-inline-start: 4px solid var(--color-highlight);
    padding-inline-start: 1rem;
    color: var(--color-text-muted);
  }

  .article-meta {
    max-inline-size: var(--width-prose);
    margin-block-start: var(--space-xl);
    border-block-start: 2px solid var(--color-structure);
    padding-block-start: 0.875rem;
  }

  .article-meta__date {
    color: var(--color-text-muted);
  }

  .article-meta__title {
    margin-block-start: var(--space-md);
    font-size: var(--text-sm);
    font-weight: 600;
    letter-spacing: var(--tracking-kicker);
    text-transform: uppercase;
    color: var(--color-text-muted);
  }

  .article-meta__sources {
    margin-block-start: 0.5rem;
    padding-inline-start: 1.125rem;
    color: var(--color-text-muted);
  }

  .article-meta__sources li {
    margin-block-end: 0.375rem;
  }
</style>
