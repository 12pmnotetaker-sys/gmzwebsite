---
import BaseLayout from '@layouts/BaseLayout.astro';
import PageHeader from '@components/PageHeader.astro';
import Placeholder from '@components/Placeholder.astro';
import { getPublishedArticles } from '@data/articles';

const articles = await getPublishedArticles();
---

<BaseLayout
  title="Answers"
  description="The questions clients actually ask, answered before they have to call."
>
  <PageHeader
    eyebrow="Straight answers"
    title="Answers"
    lede="The questions clients actually ask, answered before they have to call."
  />

  {
    articles.length > 0 && (
      <div class="container">
        <div class="section-head">
          <p class="kicker">In depth</p>
          <h2 class="section-head__title">The longer answers.</h2>
          <p class="section-head__note">
            Some questions need more than a paragraph. These are checked against their sources and
            dated, because the rules behind them change.
          </p>
        </div>

        <ul class="articles">
          {articles.map((article) => (
            <li class="articles__item">
              <a class="articles__link" href={`/faq/${article.id}`}>
                {article.data.title}
              </a>
              <p class="articles__lede">{article.data.lede}</p>
            </li>
          ))}
        </ul>
      </div>
    )
  }

  <Placeholder
    phase="Phase 2"
    what="Fifty-four published answers already exist in the portfolio repo, grouped by phase and by the four objections that lose deals."
  />
</BaseLayout>

<style>
  .articles {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
  }

  .articles__item {
    border-block-start: 1px solid var(--color-border);
    padding-block-start: 0.875rem;
  }

  .articles__link {
    font-size: var(--text-lg);
    font-weight: 700;
    letter-spacing: var(--tracking-heading);
  }

  .articles__lede {
    margin-block-start: 0.375rem;
    color: var(--color-text-muted);
    max-inline-size: var(--width-prose);
  }
</style>
