---
import { render } from 'astro:content';
import BaseLayout from '@layouts/BaseLayout.astro';
import PageHeader from '@components/PageHeader.astro';
import { getPublishedArticles } from '@data/articles';
import { factsFor, getFaqsByPhase } from '@data/faqs';
import { company, fees, primaryPhone, secondaryPhone } from '@data/site';

/*
 * Two kinds of answer on one page. The short ones come from the `faqs`
 * collection, grouped by the stage of a job they belong to; the long ones are
 * the `articles`, which carry sources and a date because they state rules.
 *
 * Every figure on this page is read from `site.ts`. An answer whose Markdown
 * would need a fee, the hours or a phone number is written without it, and the
 * fact is rendered here beneath the answer instead; see `factsFor`.
 */
const [groups, articles] = await Promise.all([getFaqsByPhase(), getPublishedArticles()]);

const sections = await Promise.all(
  groups.map(async (group) => ({
    ...group,
    items: await Promise.all(
      group.entries.map(async (entry) => ({
        entry,
        facts: factsFor(entry),
        Content: (await render(entry)).Content,
      })),
    ),
  })),
);

const phones = [primaryPhone, secondaryPhone];
const anchor = (phase: string) => `faq-${phase}`;

/* Built here rather than in the template, where a formatter's line break
   becomes a second space on the page. */
const consultationLine = `The consultation is ${fees.consultation.display} and covers ${fees.consultation.covers}.`;
const walkLine = `The maintenance walk is ${fees.maintenanceWalk.display}.`;
---

<BaseLayout
  title="Answers"
  description="The questions clients actually ask, answered before they have to call."
>
  <PageHeader
    eyebrow="Straight answers"
    title="Answers"
    lede="The questions clients actually ask, answered before they have to call."
  />

  {
    sections.length > 0 && (
      <nav class="container phases" aria-label="Stages of a job">
        <p class="kicker">By stage</p>
        <ul class="phases__list">
          {sections.map((section) => (
            <li>
              <a class="phases__link" href={`#${anchor(section.phase)}`}>
                {section.label}
              </a>
            </li>
          ))}
        </ul>
      </nav>
    )
  }

  {
    sections.map((section) => (
      <section class="section faq-phase" id={anchor(section.phase)}>
        <div class="container">
          <div class="section-head">
            <div>
              <p class="kicker">{section.label}</p>
              <h2 class="section-title">{section.heading}</h2>
            </div>
          </div>

          <div class="faqs">
            {section.items.map(({ entry, facts, Content }) => (
              <details class="faq" id={entry.id}>
                <summary class="faq__question">{entry.data.question}</summary>
                <div class="faq__answer prose">
                  <Content />
                  {facts.includes('consultation-fee') && (
                    <p class="faq__fact">{consultationLine}</p>
                  )}
                  {facts.includes('maintenance-walk') && <p class="faq__fact">{walkLine}</p>}
                  {facts.includes('hours-and-phones') && (
                    <div class="faq__fact">
                      <p>
                        {company.hours.days}, {company.hours.time}.
                      </p>
                      <ul class="faq__phones">
                        {phones.map((phone) => (
                          <li>
                            <a href={`tel:${phone.tel}`}>{phone.display}</a>
                            <span class="faq__who">{phone.name}</span>
                          </li>
                        ))}
                      </ul>
                    </div>
                  )}
                </div>
              </details>
            ))}
          </div>
        </div>
      </section>
    ))
  }

  {
    articles.length > 0 && (
      <section class="section">
        <div class="container">
          <ul class="articles">
            {articles.map((article) => (
              <li class="articles__item">
                <a class="articles__link" href={`/faq/${article.id}`}>
                  {article.data.title}
                </a>
                <p class="articles__lede">{article.data.lede}</p>
              </li>
            ))}
          </ul>
        </div>
      </section>
    )
  }
</BaseLayout>

<style>
  /* ---- The stage jump list ------------------------------------------ */

  .phases {
    margin-block-start: var(--space-lg);
  }

  .phases__list {
    list-style: none;
    margin: 0.5rem 0 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.25rem;
  }

  .phases__link {
    font-weight: 600;
    text-decoration: none;
    border-block-end: 2px solid var(--color-highlight);
  }

  .phases__link:hover {
    color: var(--color-accent-hover);
  }

  /* ---- The accordions ------------------------------------------------ */

  .faqs {
    margin-block-start: var(--space-lg);
    border-block-end: 1px solid var(--color-border);
  }

  .faq {
    border-block-start: 1px solid var(--color-border);
  }

  .faq__question {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: var(--space-md);
    padding-block: 0.875rem;
    cursor: pointer;
    font-size: var(--text-lg);
    font-weight: 700;
    letter-spacing: var(--tracking-heading);
    line-height: var(--leading-snug);
    color: var(--color-text);
    list-style: none;
  }

  .faq__question::-webkit-details-marker {
    display: none;
  }

  /* The marker is drawn rather than left to the browser, so it takes the
     amber the rest of the site uses for "the next thing". */
  .faq__question::after {
    content: '+';
    flex: none;
    inline-size: 1.5rem;
    text-align: center;
    font-weight: 600;
    color: var(--color-highlight);
    transition: transform var(--transition);
  }

  .faq[open] > .faq__question::after {
    transform: rotate(45deg);
  }

  .faq__question:hover {
    color: var(--color-accent-hover);
  }

  .faq__question:focus-visible {
    outline: 3px solid var(--color-focus);
    outline-offset: 2px;
  }

  .faq__answer {
    padding-block: 0.25rem var(--space-lg);
  }

  /* A fact read from site.ts sits under the answer, set apart so it reads
     as the number rather than as another paragraph. */
  .faq__fact {
    border-inline-start: 4px solid var(--color-highlight);
    padding-inline-start: 1rem;
    color: var(--color-text-muted);
  }

  .faq__fact p + .faq__phones {
    margin-block-start: 0.5rem;
  }

  .faq__phones {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.5rem;
  }

  .faq__phones a {
    font-weight: 600;
  }

  .faq__who {
    margin-inline-start: 0.375rem;
    font-size: var(--text-sm);
  }

  /* ---- The long answers ---------------------------------------------- */

  .articles {
    list-style: none;
    margin: var(--space-lg) 0 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
  }

  .articles__item {
    border-block-start: 1px solid var(--color-border);
    padding-block-start: 0.875rem;
  }

  .articles__link {
    font-size: var(--text-lg);
    font-weight: 700;
    letter-spacing: var(--tracking-heading);
  }

  .articles__lede {
    margin-block-start: 0.375rem;
    color: var(--color-text-muted);
    max-inline-size: var(--width-prose);
  }

  @media (prefers-reduced-motion: reduce) {
    .faq__question::after {
      transition: none;
    }
  }
</style>
