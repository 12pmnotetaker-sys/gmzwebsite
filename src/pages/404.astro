---
import BaseLayout from '@layouts/BaseLayout.astro';
import PageHeader from '@components/PageHeader.astro';
import { primaryNav, primaryCta, primaryPhone } from '@data/site';

/**
 * The page a mistyped address lands on, and, after the cutover, every old
 * address the redirect map did not cover. It is the first page some returning
 * client will see on the new site, so it is the site's own chrome, the phone
 * number, and every way onward, rather than a host's default.
 *
 * Astro writes this to 404.html and the adapter serves it with a 404 status,
 * which is what keeps it out of a search result; no noindex is needed and
 * the sitemap skips it on its own.
 */
---

<BaseLayout
  title="Page not found"
  description="That page is not here. The rest of the site is, and so is the phone number."
>
  <PageHeader
    eyebrow="Not found"
    title="That page is not here."
    lede="The address may be mistyped, or the page may have moved when the site did. Everything is still a click away."
  />

  <div class="container">
    <div class="onward">
      <section class="onward__block" aria-labelledby="onward-pages">
        <p class="kicker">Where to go</p>
        <h2 class="onward__title" id="onward-pages">The site.</h2>
        <ul class="onward__list">
          {
            primaryNav.map((item) => (
              <li>
                <a href={item.href}>{item.label}</a>
              </li>
            ))
          }
        </ul>
      </section>

      <section class="onward__block" aria-labelledby="onward-call">
        <p class="kicker">Or just ask</p>
        <h2 class="onward__title" id="onward-call">Call.</h2>
        <p>
          <a class="onward__phone" href={`tel:${primaryPhone.tel}`}>{primaryPhone.display}</a>
        </p>
        <p>
          Someone in the family answers, and a page that has moved is quicker asked about than
          searched for.
        </p>
        <a class="btn btn--amber" href={primaryCta.href}>{primaryCta.label}</a>
      </section>
    </div>
  </div>
</BaseLayout>

<style>
  .onward {
    display: grid;
    gap: var(--space-xl);
    padding-block-end: var(--space-2xl);
  }

  @media (width >= 760px) {
    .onward {
      grid-template-columns: 1fr 1fr;
    }
  }

  .onward__title {
    margin-block: 0.5rem 1rem;
  }

  .onward__list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 0.5rem;
  }

  .onward__list a {
    font-weight: 600;
  }

  .onward__phone {
    font-size: var(--text-xl, 1.5rem);
    font-weight: 700;
    text-decoration: none;
  }

  .onward__block .btn {
    margin-block-start: 1rem;
  }
</style>
