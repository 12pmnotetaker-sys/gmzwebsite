---
import { Image } from 'astro:assets';
import BaseLayout from '@layouts/BaseLayout.astro';
import PageHeader from '@components/PageHeader.astro';
import {
  formatCompleted,
  getPublishedProjects,
  projectHref,
  serviceLineLabel,
} from '@data/projects';
import { company, fees, primaryCta, serviceRegionInline } from '@data/site';

/**
 * The public half of the work: selected projects, identified by town and
 * nothing more. The private portfolio is a different collection under
 * /portfolio and is never read from here.
 *
 * GMZ has not yet chosen which projects go public, so this page has to be
 * honest with an empty list as well as correct with a full one.
 */
const projects = await getPublishedProjects();
---

<BaseLayout
  title="The Work"
  description={`Gardens, terraces and outdoor rooms built across ${serviceRegionInline}.`}
>
  <PageHeader
    eyebrow="Projects"
    title="The Work"
    lede={`Gardens, terraces and outdoor rooms built across ${serviceRegionInline}, each one identified by its town.`}
  />

  <div class="container">
    {
      projects.length > 0 ? (
        <ul class="projects">
          {projects.map((project, index) => (
            <li>
              <a class="card" href={projectHref(project)}>
                <Image
                  class="card__image"
                  src={project.data.hero.src}
                  alt={project.data.hero.alt}
                  widths={[480, 768, 1200]}
                  sizes="(width >= 1100px) 520px, (width >= 760px) 50vw, 100vw"
                  loading={index < 2 ? 'eager' : 'lazy'}
                />
                <div class="rule-accent" />
                <p class="kicker kicker--label card__line">
                  {serviceLineLabel(project.data.serviceLine)} · {project.data.location}
                </p>
                <h2 class="card__title">{project.data.title}</h2>
                <p class="card__summary">{project.data.summary}</p>
                <p class="card__completed">Completed {formatCompleted(project.data.completed)}</p>
              </a>
            </li>
          ))}
        </ul>
      ) : (
        <section class="empty">
          <div class="section-head">
            <div>
              <p class="kicker">Being prepared</p>
              <h2 class="section-title">Selected projects are on their way to this page.</h2>
            </div>
          </div>
          <div class="empty__body">
            <p>
              {company.name} is choosing which finished gardens to show here and checking with each
              client first. A public project is identified by its town and nothing more, and a
              project only appears once that has been agreed, so this page lists none rather than
              standing in with something else.
            </p>
            <p>
              The full portfolio, with the drawings behind each garden and the walkthrough film, is
              available by request. <a href="/portfolio-access">Request an access code</a>. We
              review requests and email a code when approved. A consultation is not required.
            </p>
          </div>
        </section>
      )
    }

    <section class="closing">
      <div class="section-head">
        <div>
          <p class="kicker">Seeing more</p>
          <h2 class="section-title">See more of our work.</h2>
        </div>
        <p class="section-head__note">
          The first visit is {fees.consultation.display} and covers {fees.consultation.covers}.
        </p>
      </div>
      <p class="closing__links">
        <a class="btn btn--primary" href={primaryCta.href}>
          {primaryCta.label}
        </a>
        <a class="link-accent" href="/portfolio-access">Request portfolio access</a>
      </p>
    </section>
  </div>
</BaseLayout>

<style>
  .projects {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 20rem), 1fr));
    gap: var(--space-xl) var(--space-lg);
  }

  .card {
    display: block;
    color: inherit;
    text-decoration: none;
  }

  .card__image {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    background: var(--gmz-well);
    transition: opacity var(--transition);
  }

  .card:hover .card__image {
    opacity: 0.88;
  }

  .card__line {
    margin-block-start: 0.875rem;
  }

  .card__title {
    margin-block-start: 0.375rem;
    font-size: var(--text-xl);
    font-weight: 800;
    letter-spacing: var(--tracking-heading);
    line-height: 1.2;
    color: var(--color-text);
  }

  .card:hover .card__title {
    color: var(--color-accent);
  }

  .card__summary {
    margin-block-start: 0.5rem;
    color: var(--color-text-muted);
  }

  .card__completed {
    margin-block-start: 0.5rem;
    font-size: var(--text-sm);
    color: var(--color-text-muted);
  }

  .empty__body {
    margin-block-start: var(--space-lg);
    max-inline-size: var(--width-prose);
  }

  .empty__body > p + p {
    margin-block-start: var(--space-md);
  }

  .closing {
    margin-block-start: var(--space-2xl);
    padding-block-end: var(--space-3xl);
  }

  .closing__links {
    margin-block-start: var(--space-lg);
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-md) var(--space-lg);
  }
</style>
