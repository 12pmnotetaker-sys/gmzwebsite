---
import { Image } from 'astro:assets';
import BaseLayout from '@layouts/BaseLayout.astro';
import { getProjects, heroPicture, indexCta, projectHref } from '@data/portfolio';
import { company, serviceRegionInline } from '@data/site';

/**
 * The work: a drawing-sheet index down the left, the projects themselves down
 * the right. The order is set by each entry's `order` field, not by date, so
 * whatever GMZ wants to lead with leads.
 */
const projects = await getProjects();
---

<BaseLayout
  title="The work"
  description={`Selected landscape design and construction on ${serviceRegionInline}, by ${company.legalName}.`}
>
  <div class="hero on-dark">
    <div class="hero__inner">
      <p class="kicker kicker--on-dark">Selected work · {company.serviceRegion}</p>
      <h1 class="hero__title">Cultivating enduring beauty, responsibly.</h1>
      <p class="hero__lede">
        Design, construction and ongoing care, drawn and built by the same family business since {
          company.founded
        }.
      </p>
    </div>
  </div>

  <div class="work">
    <nav class="index" aria-label="Project index">
      <p class="index__label">Index</p>
      {
        projects.map((project) => (
          <a class="index__item" href={projectHref(project)}>
            <span class="index__name">{project.data.name}</span>
            <span class="index__scope">{project.data.scope.join(' · ')}</span>
          </a>
        ))
      }
      <a class="btn btn--primary index__cta" href="/contact">Let's discuss your vision</a>
    </nav>

    <div class="entries">
      {
        projects.map((project) => {
          const hero = heroPicture(project);
          return (
            <article class="entry">
              <div class="entry__meta">
                <p class="entry__name">{project.data.name}</p>

                <p class="kicker kicker--label entry__key">Scope</p>
                <ul class="entry__scope">
                  {project.data.scope.map((item) => (
                    <li>{item}</li>
                  ))}
                </ul>

                <p class="kicker kicker--label entry__key">Stage</p>
                <p class="entry__value">{project.data.phase}</p>
              </div>

              <div class="entry__body">
                {hero ? (
                  <a class="entry__shot" href={projectHref(project)}>
                    <Image
                      src={hero.src}
                      alt={hero.alt}
                      widths={[480, 768, 1200]}
                      sizes="(width >= 1100px) 640px, (width >= 760px) 60vw, 100vw"
                      loading={project.data.order <= 2 ? 'eager' : 'lazy'}
                    />
                  </a>
                ) : (
                  <div class="entry__awaiting awaiting">
                    <span>Renderings to come</span>
                  </div>
                )}

                <div class="rule-accent" />

                <h2 class="entry__title">{project.data.title}</h2>
                <p class="entry__summary">{project.data.summary}</p>
                <a class="link-accent entry__link" href={projectHref(project)}>
                  {indexCta(project)}
                </a>
              </div>
            </article>
          );
        })
      }
    </div>
  </div>
</BaseLayout>

<style>
  .hero {
    background: var(--gmz-teal);
    padding: 2.75rem var(--gutter) 2.5rem;
  }

  .hero__inner {
    max-width: var(--width-content);
    margin-inline: auto;
  }

  .hero__title {
    margin-block-start: 0.875rem;
    font-size: var(--text-hero);
    font-weight: 800;
    letter-spacing: var(--tracking-display);
    color: #fff;
    line-height: var(--leading-tight);
    max-width: 22ch;
  }

  .hero__lede {
    margin-block-start: 1.125rem;
    font-size: var(--text-lg);
    line-height: var(--leading-normal);
    color: #fff;
    opacity: 0.86;
    max-width: 52ch;
  }

  .work {
    max-width: var(--width-content);
    margin-inline: auto;
    padding: 2.5rem var(--gutter) 0.75rem;
    display: flex;
    gap: 3rem;
    align-items: flex-start;
    flex-wrap: wrap;
  }

  /* ---- The index column ------------------------------------------------ */

  .index {
    flex: 1 1 210px;
    min-width: 210px;
    position: sticky;
    /* Clears the sticky masthead plus its amber rule. */
    top: 110px;
  }

  .index__label {
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: var(--tracking-kicker);
    text-transform: uppercase;
    color: var(--gmz-teal);
    padding-block-end: 0.625rem;
    border-block-end: 1px solid var(--color-text);
  }

  .index__item {
    display: block;
    padding-block: 0.8125rem;
    border-block-end: 1px solid var(--color-border);
    text-decoration: none;
    transition: padding-inline-start var(--transition);
  }

  .index__item:hover {
    padding-inline-start: 6px;
  }

  .index__name {
    display: block;
    font-size: var(--text-base);
    font-weight: 600;
    color: var(--color-structure);
  }

  .index__scope {
    display: block;
    font-size: 0.875rem;
    color: var(--color-text-muted);
    margin-block-start: 2px;
  }

  .index__cta {
    margin-block-start: var(--space-lg);
    font-size: var(--text-sm);
    padding: 0.875rem 1.125rem;
  }

  /* ---- The entries column ---------------------------------------------- */

  .entries {
    flex: 999 1 520px;
    min-width: 300px;
    display: flex;
    flex-direction: column;
    gap: var(--space-2xl);
  }

  .entry {
    display: flex;
    gap: 2rem;
    flex-wrap: wrap;
  }

  .entry__meta {
    flex: 1 1 150px;
    min-width: 140px;
    border-block-start: var(--rule-structure) solid var(--color-structure);
    padding-block-start: 0.75rem;
  }

  .entry__name {
    font-size: var(--text-xl);
    font-weight: 800;
    letter-spacing: -0.02em;
    color: var(--color-structure);
    line-height: var(--leading-tight);
  }

  .entry__key {
    margin-block-start: 1rem;
  }

  .entry__key:first-of-type {
    margin-block-start: 1rem;
  }

  .entry__scope {
    list-style: none;
    padding: 0;
    margin-block-start: var(--space-2xs);
    font-size: 1rem;
    color: var(--color-text);
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .entry__value {
    margin-block-start: var(--space-2xs);
    font-size: 1rem;
    color: var(--color-text);
  }

  .entry__body {
    flex: 999 1 380px;
    min-width: 280px;
  }

  .entry__shot {
    display: block;
    overflow: hidden;
    background: var(--gmz-well);
    text-decoration: none;
  }

  .entry__shot :global(img) {
    width: 100%;
    aspect-ratio: 3 / 2;
    object-fit: cover;
    display: block;
    transition: transform 800ms var(--ease);
  }

  .entry__shot:hover :global(img) {
    transform: scale(1.022);
  }

  .entry__awaiting {
    aspect-ratio: 3 / 2;
  }

  .entry__title {
    margin-block-start: 1.375rem;
    font-size: clamp(1.4375rem, 2.4vw, 1.875rem);
    font-weight: 700;
    letter-spacing: var(--tracking-heading);
    color: var(--color-text);
    line-height: 1.3;
  }

  .entry__summary {
    margin-block-start: 0.8125rem;
    font-size: var(--text-base);
    line-height: var(--leading-normal);
    color: var(--color-text);
    max-width: 58ch;
  }

  .entry__link {
    margin-block-start: 1.25rem;
  }

  /* The index stops being a sidebar once it would be narrower than its own
     type. It stays at the top of the page, as a table of contents. */
  @media (width < 900px) {
    .index {
      position: static;
      flex-basis: 100%;
    }
  }
</style>
