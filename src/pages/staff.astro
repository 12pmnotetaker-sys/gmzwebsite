---
import Logo from '@components/Logo.astro';
import '@styles/global.css';
---

<!doctype html>
<html lang="en">
  <head
    ><meta charset="UTF-8" /><meta
      name="viewport"
      content="width=device-width, initial-scale=1"
    /><meta name="robots" content="noindex,nofollow" /><title>GMZ Staff</title><link
      rel="icon"
      href="/favicon.png"
    /></head
  ><body
    ><main class="staff-entry">
      <a href="/" aria-label="GMZ home"><Logo height={48} /></a><p class="kicker">
        GMZ FIELD TEAM
      </p><h1>Field team workspace</h1><p>Your route, hours, and time-away requests.</p><a
        class="btn btn--amber"
        href="https://gmz-operations.gmzhavi.chatgpt.site/staff">Open GMZ Staff ↗</a
      ><p class="access-note">
        Uses the existing private ChatGPT access. Vercel staff accounts will be added later.
      </p><nav aria-label="Other portals">
        <a href="/staff/prototype">Staff prototype</a>
        <a href="/admin">GMZ Admin</a><a href="/portal/sign-in">Client portal</a><a href="/"
          >Back to website</a
        >
      </nav>
    </main></body
  >
</html>
<style>
  .staff-entry {
    min-height: 100dvh;
    background: var(--gmz-teal);
    color: white;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    justify-content: center;
    padding: clamp(28px, 8vw, 120px);
    gap: 24px;
  }
  .staff-entry h1 {
    font-size: clamp(32px, 5vw, 64px);
    line-height: 1.08;
  }
  .staff-entry p {
    max-width: 48ch;
    line-height: 1.6;
  }
  .staff-entry .kicker {
    color: var(--gmz-amber);
  }
  .access-note {
    color: #bdcdd1;
    font-size: 14px;
  }
  .staff-entry nav {
    display: flex;
    flex-wrap: wrap;
    gap: 24px;
    margin-top: 24px;
  }
  .staff-entry nav a {
    color: white;
    font-size: 14px;
  }
</style>
