---
import BaseLayout from '@layouts/BaseLayout.astro';
import HeroVideo from '@components/HeroVideo.astro';
import { company, fees, foundedLine, serviceRegionInline } from '@data/site';
import { getPublishedArticles } from '@data/articles';
import { getPublishedTowns, townHref } from '@data/towns';
import { getServices, serviceHref } from '@data/services';

const towns = await getPublishedTowns();
const articles = await getPublishedArticles();
/*
 * The three service lines come from the collection rather than a second list
 * kept in step by hand. One fact, one home: renaming a service should not mean
 * remembering to edit the home page too.
 */
const services = await getServices();
---

<BaseLayout>
  <HeroVideo>
    <p class="kicker kicker--hero">{company.tagline}</p>
    <h1 class="page-title hero__title">{company.summary}</h1>
    <div class="rule-accent rule-accent--short"></div>
    <p class="lead hero__lede">
      {company.legalName}, a family company working across {serviceRegionInline}
      {foundedLine}.
    </p>
  </HeroVideo>

  <section class="section">
    <div class="container">
      <div class="section-head">
        <div>
          <p class="kicker">What we do</p>
          <h2 class="section-title">Three stages, one company.</h2>
        </div>
        <p class="section-head__note">
          The same people carry a garden from the first sketch to the fiftieth visit.
        </p>
      </div>

      <ul class="stages">
        {
          services.map((service) => (
            <li class="stage">
              <h3 class="stage__name">
                <a href={serviceHref(service)}>{service.data.title}</a>
              </h3>
              <p class="stage__what">{service.data.summary}</p>
            </li>
          ))
        }
      </ul>
      <p class="stages__more">More services upon request.</p>
    </div>
  </section>

  <section class="section section--tint">
    <div class="container">
      <div class="section-head">
        <div>
          <p class="kicker">Where we work</p>
          <h2 class="section-title">The Peninsula, from the Redwood City yard.</h2>
        </div>
        <p class="section-head__note">
          If you are outside the service area, an accommodation can be made upon request. A
          {' '}{fees.travel.display} travel charge applies {fees.travel.note}.
        </p>
      </div>

      <ul class="towns">
        {
          company.serviceArea.map((name) => {
            const town = towns.find((entry) => entry.data.name === name);
            return (
              <li class="town">
                {town ? <a href={townHref(town)}>{name}</a> : <span>{name}</span>}
              </li>
            );
          })
        }
      </ul>
      <p class="towns__note">
        The linked towns have a page on what their own rules require before design starts.
      </p>
    </div>
  </section>

  {
    articles.length > 0 && (
      <section class="section">
        <div class="container">
          <div class="section-head">
            <div>
              <p class="kicker">Answers</p>
              <h2 class="section-title">The questions worth settling early.</h2>
            </div>
          </div>
          <ul class="answers">
            {articles.map((article) => (
              <li class="answer">
                <a class="answer__link" href={`/faq/${article.id}`}>
                  {article.data.title}
                </a>
                <p class="answer__lede">{article.data.lede}</p>
              </li>
            ))}
          </ul>
        </div>
      </section>
    )
  }

  <section class="section section--tint">
    <div class="container">
      <div class="section-head">
        <div>
          <p class="kicker">The work</p>
          <h2 class="section-title">The portfolio sits behind a code.</h2>
        </div>
        <p class="section-head__note">
          Finished gardens, the drawings behind them and walkthrough film, shown to clients after a
          consultation rather than published. The code comes with the visit.
        </p>
      </div>
      <p class="portfolio-link">
        <a class="link-accent" href="/portfolio">Open the portfolio</a>
      </p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-head">
        <div>
          <p class="kicker">What it costs to start</p>
          <h2 class="section-title">The first visit is a fixed price.</h2>
        </div>
      </div>
      <dl class="fees">
        <div class="fee">
          <dt>{fees.consultation.display}</dt>
          <dd>Design consultation, covering {fees.consultation.covers}.</dd>
        </div>
        <div class="fee">
          <dt>{fees.maintenanceWalk.display}</dt>
          <dd>Maintenance walk, to price looking after a garden that already exists.</dd>
        </div>
      </dl>
      <p class="fees__note">Neither fee is credited toward a later stage.</p>
    </div>
  </section>
</BaseLayout>

<style>
  /* The hero now sits on the film, so its type is inverted. The kicker's
     structural blue does not survive on the teal scrim; amber does, and it is
     the same accent the masthead rule uses. */
  .kicker--hero {
    color: var(--gmz-amber);
  }

  .hero__title {
    margin-block-start: 0.875rem;
    max-width: 20ch;
    color: #fff;
  }

  .hero__lede {
    margin-block-start: 1.375rem;
    color: color-mix(in srgb, #fff 88%, transparent);
    max-width: 46ch;
  }

  .portfolio-link {
    margin-block-start: var(--space-lg);
  }

  .section--tint {
    background: var(--color-bg-subtle);
  }

  .stages {
    list-style: none;
    margin: var(--space-lg) 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--space-lg);
  }

  .stage {
    border-block-start: 2px solid var(--color-structure);
    padding-block-start: 0.875rem;
  }

  .stage__name {
    margin: 0;
    font-size: var(--text-xl);
    letter-spacing: var(--tracking-heading);
  }

  .stage__what {
    margin-block-start: 0.5rem;
    color: var(--color-text-muted);
  }

  .stages__more {
    margin-block-start: var(--space-md);
    color: var(--color-text-muted);
  }

  .towns {
    list-style: none;
    margin: var(--space-lg) 0 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .town a,
  .town span {
    display: block;
    border: 1px solid var(--color-border);
    background: var(--color-bg);
    padding: 0.5rem 0.875rem;
  }

  .town span {
    color: var(--color-text-muted);
  }

  .towns__note {
    margin-block-start: var(--space-md);
    color: var(--color-text-muted);
  }

  .answers {
    list-style: none;
    margin: var(--space-lg) 0 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
  }

  .answer {
    border-block-start: 1px solid var(--color-border);
    padding-block-start: 0.875rem;
  }

  .answer__link {
    font-size: var(--text-lg);
    font-weight: 700;
    letter-spacing: var(--tracking-heading);
  }

  .answer__lede {
    margin-block-start: 0.375rem;
    color: var(--color-text-muted);
    max-inline-size: var(--width-prose);
  }

  .fees {
    margin: var(--space-lg) 0 0;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-lg);
    max-inline-size: var(--width-prose);
  }

  .fee {
    border-block-start: 2px solid var(--color-structure);
    padding-block-start: 0.875rem;
  }

  .fee dt {
    font-size: var(--text-2xl);
    font-weight: 800;
    letter-spacing: var(--tracking-heading);
  }

  .fee dd {
    margin: 0.375rem 0 0;
    color: var(--color-text-muted);
  }

  .fees__note {
    margin-block-start: var(--space-md);
    color: var(--color-text-muted);
  }

  @media (width < 760px) {
    .stages,
    .fees {
      grid-template-columns: 1fr;
    }
  }
</style>
