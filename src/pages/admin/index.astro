---
import AdminLayout from '@layouts/AdminLayout.astro';

/**
 * Staff sign-in for the leads inbox.
 *
 * There is no sign-up here and never should be: staff accounts are created in
 * the Supabase dashboard, and who counts as staff is the `ADMIN_ALLOWED_EMAILS`
 * allowlist api/admin/leads.ts checks on every request. This page only proves
 * who somebody is; it does not decide whether they belong.
 */
---

<AdminLayout title="Sign in">
  <div class="login">
    <p class="kicker">GMZ Admin</p>
    <h1 class="page-title">Sign in</h1>
    <p class="lead">Leads from the website's contact form. Staff accounts only.</p>

    <form class="login__form" novalidate data-admin-login>
      <div class="field">
        <label class="field__label" for="email">Email</label>
        <input
          class="field__input"
          id="email"
          name="email"
          type="email"
          autocomplete="username"
          required
        />
      </div>

      <div class="field">
        <label class="field__label" for="password">Password</label>
        <input
          class="field__input"
          id="password"
          name="password"
          type="password"
          autocomplete="current-password"
          required
        />
      </div>

      <p class="field__error" id="login-error" role="alert" hidden></p>

      <button class="btn btn--primary btn--block" type="submit" data-admin-submit>Sign in</button>
    </form>
  </div>
</AdminLayout>

<script>
  import { getSession, setSession } from '@data/adminSession';

  const SUPABASE_URL = import.meta.env.PUBLIC_SUPABASE_URL as string | undefined;
  const SUPABASE_ANON_KEY = import.meta.env.PUBLIC_SUPABASE_ANON_KEY as string | undefined;

  const form = document.querySelector<HTMLFormElement>('[data-admin-login]');
  const submit = document.querySelector<HTMLButtonElement>('[data-admin-submit]');
  const error = document.getElementById('login-error');

  // Already signed in with time left on the session: skip straight to the inbox.
  if (getSession()) {
    window.location.replace('/admin/leads');
  }

  const showError = (message: string) => {
    if (!error) return;
    error.textContent = message;
    error.hidden = false;
  };

  if (form && submit) {
    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      if (submit.disabled) return;

      if (error) error.hidden = true;

      if (!SUPABASE_URL || !SUPABASE_ANON_KEY) {
        showError('This page is not configured yet. Ask whoever deployed the site to set it up.');
        return;
      }

      const data = new FormData(form);
      const email = String(data.get('email') ?? '').trim();
      const password = String(data.get('password') ?? '');

      submit.disabled = true;
      submit.textContent = 'Signing in';

      try {
        const response = await fetch(`${SUPABASE_URL}/auth/v1/token?grant_type=password`, {
          method: 'POST',
          headers: { apikey: SUPABASE_ANON_KEY, 'Content-Type': 'application/json' },
          body: JSON.stringify({ email, password }),
        });

        if (!response.ok) {
          showError('That email and password combination was not recognised.');
          return;
        }

        const token = (await response.json()) as {
          access_token: string;
          refresh_token: string;
          expires_in: number;
        };

        setSession({
          accessToken: token.access_token,
          refreshToken: token.refresh_token,
          email,
          expiresAt: Date.now() + token.expires_in * 1000,
        });

        window.location.assign('/admin/leads');
      } catch {
        showError('Could not reach the sign-in service. Check the connection and try again.');
      } finally {
        submit.disabled = false;
        submit.textContent = 'Sign in';
      }
    });
  }
</script>

<style>
  .login {
    max-inline-size: 26rem;
  }

  .login__form {
    margin-block-start: var(--space-xl);
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
  }

  .field__label {
    display: block;
    font-weight: 600;
    letter-spacing: var(--tracking-heading);
  }

  .field__input {
    display: block;
    inline-size: 100%;
    margin-block-start: 0.375rem;
    font-family: var(--font-body);
    font-size: var(--text-base);
    color: var(--color-text);
    background: var(--color-bg);
    border: 1px solid var(--color-border-strong);
    padding: 0.75rem 0.875rem;
  }

  .field__input:focus-visible {
    border-color: var(--color-accent);
  }

  .field__error {
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--color-text);
    border-inline-start: var(--rule-accent) solid var(--color-highlight);
    padding-inline-start: 0.625rem;
  }
</style>
