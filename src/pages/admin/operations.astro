---
export const prerender = false;
import wordmark from '@/assets/brand/gmz-wordmark.png';
import Operations from '../../operations/operations';
import '../../operations/operations.css';
import { ADMIN_COOKIE, authenticateAdmin, privateHeaders, passwordClient, sameOrigin } from '../../server/operations-admin/auth';
Object.entries(privateHeaders).forEach(([k,v])=>Astro.response.headers.set(k,v));
let message = '';
if (Astro.request.method === 'POST') {
  if (!sameOrigin(Astro.request)) return new Response('Forbidden',{status:403,headers:privateHeaders});
  try {
    const form = await Astro.request.formData();
    if (form.get('action') === 'logout') { Astro.cookies.delete(ADMIN_COOKIE,{path:'/'}); return Astro.redirect('/admin/operations'); }
    const email = String(form.get('email')||'').trim();
    const password = String(form.get('password')||'');
    if (email.length > 254 || password.length > 512) throw Error('Invalid credentials');
    const {data,error} = await passwordClient().auth.signInWithPassword({email,password});
    const admin = !error && data.session ? await authenticateAdmin(data.session.access_token) : null;
    if (!admin || !data.session) { message = 'Sign-in failed. Use an account enabled for GMZ Admin.'; }
    else {
      Astro.cookies.set(ADMIN_COOKIE,data.session.access_token,{httpOnly:true,secure:Astro.url.protocol==='https:',sameSite:'strict',path:'/',maxAge:Math.min(data.session.expires_in,3600)});
      return Astro.redirect('/admin/operations');
    }
  } catch { message = 'Admin sign-in is unavailable. Please try again later.'; }
}
let admin = null;
try { admin = await authenticateAdmin(Astro.cookies.get(ADMIN_COOKIE)?.value); }
catch { message = 'Admin access is being configured. Your current private workspace remains available.'; }
---
<html lang="en"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width"/><meta name="robots" content="noindex,nofollow"/><title>GMZ Operations</title></head>
<body>
{admin ? <><form method="POST" class="admin-session"><span>GMZ Admin</span><button name="action" value="logout">Sign out</button></form><Operations displayName={admin.email} client:only="react"/></> : <main class="admin-login"><img src={wordmark.src} alt="GMZ Landscaping" width="235"/><h1>GMZ Operations</h1><p>Sign in with your enabled Admin account.</p>{message && <p role="alert">{message}</p>}<form method="POST"><label>Email<input type="email" name="email" autocomplete="username" required maxlength="254"/></label><label>Password<input type="password" name="password" autocomplete="current-password" required maxlength="512"/></label><button type="submit">Sign in</button></form><a href="https://gmz-operations.gmzhavi.chatgpt.site/">Open current private workspace ↗</a><p>Account setup is required before the Vercel workspace can be used.</p></main>}
</body></html>
<style>.admin-login{max-width:460px;margin:10vh auto;padding:32px;font-size:16px}.admin-login h1{font-size:32px;margin:24px 0 12px}.admin-login p{margin:16px 0;line-height:1.6}.admin-login form,.admin-login label{display:flex;flex-direction:column;gap:12px}.admin-login input{border:1px solid #9db3ba;padding:12px;margin-bottom:12px}.admin-login button{background:#002b37;color:white;padding:14px;margin:8px 0 24px}.admin-login a{text-decoration:underline}.admin-session{display:flex;justify-content:flex-end;gap:24px;padding:8px 24px;background:#002b37;color:white}.admin-session button{text-decoration:underline}</style>
