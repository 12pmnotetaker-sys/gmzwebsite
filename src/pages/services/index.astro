---
import BaseLayout from '@layouts/BaseLayout.astro';
import PageHeader from '@components/PageHeader.astro';
import { getServices, serviceHref } from '@data/services';
import { serviceVisuals } from '@data/site-visuals';

const services = await getServices();
---

<BaseLayout
  title="Services"
  description="Landscape design, landscape construction and landscape maintenance, carried by one company from the first sketch to the fiftieth visit."
>
  <PageHeader
    eyebrow="What we do"
    title="Services"
    lede="Three lines of work, carried by one company. The people who draw a garden are the people who build it and the people who come back to look after it."
  />

  <div class="container">
    <ul class="services">
      {
        services.map((service) => (
          <li class="service">
            {
              serviceVisuals[service.id as keyof typeof serviceVisuals] && (
                <img
                  class="service__image"
                  src={serviceVisuals[service.id as keyof typeof serviceVisuals].image.src}
                  alt={serviceVisuals[service.id as keyof typeof serviceVisuals].alt}
                  loading="lazy"
                />
              )
            }
            <div class="service__body">
            <h2 class="service__title">
              <a href={serviceHref(service)}>{service.data.title}</a>
            </h2>
            <p class="service__summary">{service.data.summary}</p>
            {service.data.highlights.length > 0 && (
              <ul class="service__points">
                {service.data.highlights.map((point) => (
                  <li>{point}</li>
                ))}
              </ul>
            )}
            </div>
          </li>
        ))
      }
    </ul>

    <p class="services__more">More services upon request.</p>
  </div>
</BaseLayout>

<style>
  .services {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-xl);
  }

  .service {
    display: grid;
    grid-template-columns: minmax(11rem, 0.72fr) minmax(0, 1fr);
    gap: var(--space-lg);
    align-items: start;
    border-block-start: 2px solid var(--color-structure);
    padding-block-start: 0.875rem;
  }

  .service__image {
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    display: block;
  }

  .service__title {
    margin: 0;
    font-size: var(--text-2xl);
    font-weight: 800;
    letter-spacing: var(--tracking-heading);
  }

  .service__summary {
    margin-block-start: 0.5rem;
    max-inline-size: var(--width-prose);
  }

  .service__points {
    margin-block-start: var(--space-md);
    padding-inline-start: 1.125rem;
    color: var(--color-text-muted);
    max-inline-size: var(--width-prose);
  }

  .service__points li {
    margin-block-end: 0.375rem;
  }

  .services__more {
    margin-block-start: var(--space-xl);
    color: var(--color-text-muted);
  }

  @media (width < 680px) {
    .service {
      grid-template-columns: 1fr;
    }

    .service__image {
      max-block-size: 20rem;
    }
  }
</style>
