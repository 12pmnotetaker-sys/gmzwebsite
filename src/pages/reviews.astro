---
import BaseLayout from '@layouts/BaseLayout.astro';
import PageHeader from '@components/PageHeader.astro';
import ReviewList from '@components/ReviewList.astro';
import { getApprovedReviews } from '@data/reviews';
import { company, primaryCta } from '@data/site';

const reviews = await getApprovedReviews();
---

<BaseLayout
  title="Reviews"
  description="What clients have said in public, with a link to the original in every case."
>
  <PageHeader
    eyebrow="In their words"
    title="Reviews"
    lede="What clients have written in public, linked back to the original so you can read it in full where it was posted."
  />

  {
    reviews.length > 0 ? (
      <div class="container">
        <ReviewList {reviews} />
      </div>
    ) : (
      <section class="container empty">
        <div class="section-head">
          <div>
            <p class="kicker">Nothing quoted yet</p>
            <h2 class="section-title">This page lists no reviews for now.</h2>
          </div>
        </div>
        <div class="empty__body">
          <p>
            Reviews shown here are gathered from public platforms and linked back to the original,
            so every quote is one you can go and read where it was written. A client leaving a
            public review is not the same as agreeing to be quoted on this site, and until{' '}
            {company.name} has confirmed with each reviewer that their words may be repeated here,
            the page stays empty rather than showing words nobody agreed to.
          </p>
          {company.social.houzz && (
            <p>
              Reviews that already exist in public can be read on{' '}
              <a
                class="link-accent"
                href={company.social.houzz}
                rel="noopener noreferrer"
                target="_blank"
              >
                the {company.name} profile on Houzz
              </a>
              .
            </p>
          )}
          <p class="empty__cta">
            <a class="btn btn--primary" href={primaryCta.href}>
              {primaryCta.label}
            </a>
          </p>
        </div>
      </section>
    )
  }
</BaseLayout>

<style>
  .empty {
    padding-block-end: var(--space-3xl);
  }

  .empty__body {
    margin-block-start: var(--space-lg);
    max-inline-size: var(--width-prose);
  }

  .empty__body > p + p {
    margin-block-start: var(--space-md);
  }

  .empty__cta {
    margin-block-start: var(--space-lg);
  }
</style>
