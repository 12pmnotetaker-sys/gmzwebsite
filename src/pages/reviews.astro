---
import BaseLayout from '@layouts/BaseLayout.astro';
import PageHeader from '@components/PageHeader.astro';
import ReviewList from '@components/ReviewList.astro';
import { getApprovedReviews } from '@data/reviews';
import { company, primaryCta } from '@data/site';

const reviews = await getApprovedReviews();
---

<BaseLayout
  title="Reviews"
  description="What clients have said in public, with a link to the original in every case."
>
  <PageHeader
    eyebrow="In their words"
    title="Reviews"
    lede="What clients have written in public, linked back to the original so you can read it in full where it was posted."
  />

  {
    reviews.length > 0 ? (
      <div class="container">
        <ReviewList {reviews} />
      </div>
    ) : (
      <section class="container empty">
        <div class="empty__body">
          <h2 class="section-title">Read client reviews on Houzz.</h2>
          <p>
            Visit our profile to read what clients have shared about working with {company.name}.
          </p>
          {company.social.houzz && (
            <p class="empty__cta">
              <a
                class="btn btn--primary"
                href={company.social.houzz}
                target="_blank"
                rel="noopener noreferrer"
              >
                Read reviews on Houzz
              </a>
            </p>
          )}
          <p>
            <a href={primaryCta.href}>Tell us about your project</a>
          </p>
        </div>
      </section>
    )
  }
</BaseLayout>

<style>
  .empty {
    padding-block-end: var(--space-3xl);
  }

  .empty__body {
    margin-block-start: var(--space-lg);
    max-inline-size: var(--width-prose);
  }

  .empty__body > p + p {
    margin-block-start: var(--space-md);
  }

  .empty__cta {
    margin-block-start: var(--space-lg);
  }
</style>
