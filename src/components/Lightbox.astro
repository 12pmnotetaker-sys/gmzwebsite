---
import { getImage } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';

interface Props {
  project: CollectionEntry<'portfolio'>;
}

const { project } = Astro.props;
const { drawings, built, photos, name } = project.data;

/**
 * The three sets a visitor can zoom into, prepared at build time.
 *
 * Each entry uses its `full` crop where one exists, capped at the source
 * width so a smaller original is never upscaled into a soft image. The grids
 * keep loading their own smaller versions, so this larger file is only ever
 * fetched by someone who actually zoomed in.
 */
type Picture = CollectionEntry<'portfolio'>['data']['built'][number];

const prepare = (pictures: Picture[]) =>
  Promise.all(
    pictures.map(async (picture) => {
      const source = picture.full ?? picture.src;
      const image = await getImage({
        src: source,
        width: Math.min(2000, source.width),
      });
      return {
        src: image.src,
        alt: picture.alt,
        label: picture.label,
        note: picture.note ?? '',
      };
    }),
  );

const sets = {
  drawings: await prepare(drawings),
  built: await prepare(built),
  photos: await prepare(photos),
};

const hasAny = Object.values(sets).some((set) => set.length > 0);
---

{
  hasAny && (
    <>
      <script type="application/json" is:inline data-lb-data set:html={JSON.stringify(sets)} />

      <dialog class="lb on-dark" data-lb aria-label={`${name}, full screen`}>
        <div class="lb__bar">
          <div class="lb__id">
            <p class="kicker kicker--on-dark">
              {name} · <span data-lb-count />
            </p>
            <p class="lb__label" data-lb-label />
          </div>
          <button type="button" class="lb__close" aria-label="Close" data-lb-close>
            &times;
          </button>
        </div>

        <div class="lb__stage" data-lb-stage>
          <button type="button" class="lb__step" aria-label="Previous image" data-lb-prev>
            &lsaquo;
          </button>
          <img data-lb-image alt="" data-alt-set-by-script />
          <button type="button" class="lb__step" aria-label="Next image" data-lb-next>
            &rsaquo;
          </button>
        </div>

        <p class="lb__note" data-lb-note />
      </dialog>
    </>
  )
}

<script>
  /*
   * The full-screen viewer.
   *
   * A native <dialog> opened with showModal() rather than a hand-rolled
   * overlay, which buys the focus trap, the Escape key and the inert page
   * behind it without writing any of them. Left and right arrows step through
   * the set, and a horizontal swipe does the same on a touch screen.
   */
  interface Item {
    src: string;
    alt: string;
    label: string;
    note: string;
  }

  const source = document.querySelector<HTMLScriptElement>('[data-lb-data]');
  const dialog = document.querySelector<HTMLDialogElement>('[data-lb]');

  if (source?.textContent && dialog) {
    const sets: Record<string, Item[]> = JSON.parse(source.textContent);

    const image = dialog.querySelector<HTMLImageElement>('[data-lb-image]')!;
    const label = dialog.querySelector<HTMLElement>('[data-lb-label]')!;
    const note = dialog.querySelector<HTMLElement>('[data-lb-note]')!;
    const count = dialog.querySelector<HTMLElement>('[data-lb-count]')!;
    const stage = dialog.querySelector<HTMLElement>('[data-lb-stage]')!;

    let items: Item[] = [];
    let at = 0;

    const show = (index: number) => {
      if (items.length === 0) return;
      at = (index + items.length) % items.length;
      const item = items[at];
      image.src = item.src;
      // The markup ships alt="" because there is no image in the dialog until
      // one is chosen. `data-alt-set-by-script` on that <img> tells
      // scripts/content-lint.mjs the empty alt is a placeholder rather than a
      // missing description; this line is what makes that true.
      image.alt = item.alt;
      label.textContent = item.label;
      note.textContent = item.note;
      count.textContent = `${at + 1} of ${items.length}`;
    };

    const open = (setName: string, index: number) => {
      items = sets[setName] ?? [];
      if (items.length === 0) return;
      show(index);
      dialog.showModal();
      document.documentElement.style.overflow = 'hidden';
    };

    // Every zoomable image and "View full screen" button says which set it
    // belongs to and where in it, so one handler covers the whole page.
    for (const trigger of document.querySelectorAll<HTMLElement>('[data-lb-set]')) {
      trigger.addEventListener('click', () => {
        open(trigger.dataset.lbSet!, Number(trigger.dataset.lbIndex) || 0);
      });
    }

    const close = () => dialog.close();
    dialog.querySelector('[data-lb-close]')?.addEventListener('click', close);
    dialog.querySelector('[data-lb-prev]')?.addEventListener('click', () => show(at - 1));
    dialog.querySelector('[data-lb-next]')?.addEventListener('click', () => show(at + 1));

    // Clicking the ground around the image closes; clicking the image or the
    // controls does not.
    dialog.addEventListener('click', (event) => {
      if (event.target === dialog) close();
    });
    stage.addEventListener('click', (event) => {
      if (event.target === stage) close();
    });

    dialog.addEventListener('close', () => {
      document.documentElement.style.overflow = '';
    });

    dialog.addEventListener('keydown', (event) => {
      if (event.key === 'ArrowRight') {
        event.preventDefault();
        show(at + 1);
      } else if (event.key === 'ArrowLeft') {
        event.preventDefault();
        show(at - 1);
      }
    });

    let startX: number | null = null;
    stage.addEventListener('touchstart', (event) => {
      startX = event.touches[0]?.clientX ?? null;
    });
    stage.addEventListener('touchend', (event) => {
      if (startX === null) return;
      const dx = (event.changedTouches[0]?.clientX ?? startX) - startX;
      startX = null;
      if (Math.abs(dx) > 44) show(at + (dx < 0 ? 1 : -1));
    });
  }
</script>

<style>
  .lb {
    padding: 0;
    border: none;
    max-width: 100vw;
    max-height: 100dvh;
    width: 100vw;
    height: 100dvh;
    background: rgb(0 43 55 / 97%);
    color: #fff;
    flex-direction: column;
  }

  .lb[open] {
    display: flex;
  }

  .lb::backdrop {
    background: rgb(0 43 55 / 97%);
  }

  .lb__bar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1.25rem;
    padding: 1.125rem 1.5rem;
    flex: none;
  }

  .lb__id {
    min-width: 0;
  }

  .lb__label {
    font-size: 1.1875rem;
    font-weight: 600;
    color: #fff;
    margin-block-start: 3px;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .lb__close {
    font-family: var(--font-body);
    font-size: 2rem;
    line-height: 1;
    color: #fff;
    background: transparent;
    border: none;
    padding: 0.75rem;
    cursor: pointer;
    flex: none;
  }

  .lb__stage {
    flex: 1 1 auto;
    min-height: 0;
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0 0.75rem 0.75rem;
  }

  .lb__stage img {
    flex: 1 1 auto;
    min-width: 0;
    width: 100%;
    max-width: 100%;
    max-height: 100%;
    height: 100%;
    object-fit: contain;
    margin-inline: auto;
  }

  .lb__step {
    font-family: var(--font-body);
    font-size: 1.625rem;
    color: #fff;
    background: rgb(255 255 255 / 12%);
    border: none;
    width: 52px;
    height: 52px;
    cursor: pointer;
    flex: none;
  }

  .lb__step:hover {
    background: rgb(255 255 255 / 22%);
  }

  .lb__note {
    flex: none;
    padding: 0 1.5rem 1.25rem;
    font-size: var(--text-sm);
    line-height: 1.6;
    color: #fff;
    opacity: 0.86;
    max-width: 70ch;
  }
</style>
