---
import { Image } from 'astro:assets';
import Logo from '@components/Logo.astro';
import apldLogo from '@/assets/brand/apld-logo.webp';
import {
  company,
  primaryPhone,
  primaryCta,
  hoursInline,
  foundedLine,
  serviceRegionInline,
} from '@data/site';

/**
 * The closing invitation, then the facts.
 *
 * Every value here reads from src/data/site.ts. The licence line is not
 * decoration: California requires the number in advertising, so it renders on
 * every page rather than only on a contact page.
 *
 * Note what is absent. There is no "licensed and insured" line, because the
 * insurance half of that claim is unconfirmed. See `claims` in site.ts.
 */
const membership = company.memberships[0];
const year = new Date().getFullYear();
---

<footer class="footer on-dark">
  <div class="footer__invite">
    <div class="container">
      <p class="kicker kicker--on-dark">Next step</p>
      <p class="footer__headline">Tell us about the property.</p>
      <a class="btn btn--amber footer__cta" href={primaryCta.href}>{primaryCta.label}</a>
    </div>
  </div>

  <div class="container">
    <div class="footer__marks">
      <Logo height={56} />
      {
        membership && (
          <div class="footer__plate">
            <Image src={apldLogo} alt={membership.name} height={34} densities={[1, 2]} />
          </div>
        )
      }
    </div>

    <div class="footer__divider"></div>

    <div class="footer__grid">
      <div>
        <p class="footer__label">Call</p>
        <a class="footer__value" href={`tel:${primaryPhone.tel}`}>{primaryPhone.display}</a>
        <p class="footer__muted">{hoursInline}</p>
      </div>

      <div>
        <p class="footer__label">Email</p>
        <a class="footer__value" href={`mailto:${company.email}`}>{company.email}</a>
      </div>

      <div>
        <p class="footer__label">Post</p>
        {company.address.mailingLines.map((line) => <p class="footer__value">{line}</p>)}
      </div>

      <div>
        <p class="footer__label">Where we work</p>
        <p class="footer__value">{company.serviceRegion}</p>
        <p class="footer__muted">{company.serviceArea.join(', ')}</p>
      </div>
    </div>

    <div class="footer__divider"></div>

    <p class="footer__legal">
      {company.legalName}, {foundedLine}. {company.license.display}. Landscape design, build and
      maintenance across {serviceRegionInline}. &copy; {year}
    </p>
  </div>
</footer>

<style>
  .footer {
    background: var(--gmz-teal);
    color: #fff;
    padding-block-end: var(--space-xl);
  }

  .footer__invite {
    padding-block: var(--space-2xl);
    border-block-end: 1px solid rgb(255 255 255 / 16%);
  }

  .footer__headline {
    margin-block-start: 0.75rem;
    font-family: var(--font-heading);
    font-size: var(--text-3xl);
    font-weight: 800;
    letter-spacing: var(--tracking-heading);
    line-height: 1.15;
    max-width: 18ch;
  }

  .footer__cta {
    margin-block-start: var(--space-lg);
  }

  .footer__marks {
    display: flex;
    align-items: center;
    gap: var(--space-lg);
    padding-block-start: var(--space-xl);
    flex-wrap: wrap;
  }

  /* The APLD mark is dark artwork, so it needs a light plate under it. */
  .footer__plate {
    background: #fff;
    padding: 0.5rem 0.75rem;
    display: flex;
    align-items: center;
  }

  .footer__divider {
    height: 1px;
    background: rgb(255 255 255 / 16%);
    margin-block: var(--space-lg);
  }

  .footer__grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(13rem, 1fr));
    gap: var(--space-lg);
  }

  .footer__label {
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--gmz-amber);
    margin-block-end: 0.4375rem;
  }

  .footer__value {
    display: block;
    font-size: var(--text-base);
    color: #fff;
    text-decoration: none;
    line-height: 1.5;
  }

  a.footer__value:hover {
    color: var(--gmz-amber);
  }

  .footer__muted {
    margin-block-start: 0.3125rem;
    font-size: var(--text-sm);
    color: rgb(255 255 255 / 68%);
    line-height: 1.5;
  }

  .footer__legal {
    font-size: var(--text-sm);
    color: rgb(255 255 255 / 68%);
    line-height: 1.6;
  }
</style>
