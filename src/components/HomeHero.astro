---
import { Image } from 'astro:assets';
import garden from '@/assets/home/woodside-garden.webp';
---

<section class="home-hero on-dark" aria-label="A garden installed by Rafael Gomez">
  <Image
    class="home-hero__image"
    src={garden}
    alt="Stone steps descend through flowering grasses toward a lawn and wooded hills in evening light."
    widths={[640, 960, 1280, 1800]}
    sizes="100vw"
    width={1800}
    quality={85}
    loading="eager"
    fetchpriority="high"
  />
  <div class="home-hero__scrim" aria-hidden="true"></div>
  <div class="home-hero__content container"><slot /></div>
  <div class="home-hero__credit">
    <p class="container">
      Woodside garden · Installation: Rafael Gomez · Design: Chris Jacobson · Photography: © Marion
      Brenner
    </p>
  </div>
</section>

<style>
  .home-hero {
    position: relative;
    isolation: isolate;
    background: var(--gmz-teal);
    display: grid;
    align-content: end;
    min-block-size: clamp(34rem, 74vh, 48rem);
    overflow: hidden;
  }

  .home-hero__image {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 58%;
    z-index: -2;
  }

  .home-hero__scrim {
    position: absolute;
    inset: 0;
    z-index: -1;
    background: linear-gradient(
      90deg,
      color-mix(in srgb, var(--gmz-teal) 88%, transparent) 0%,
      color-mix(in srgb, var(--gmz-teal) 72%, transparent) 38%,
      color-mix(in srgb, var(--gmz-teal) 16%, transparent) 75%,
      transparent 100%
    );
  }

  .home-hero__content {
    width: 100%;
    padding-block: var(--space-3xl) var(--space-2xl);
  }

  .home-hero__credit {
    background: color-mix(in srgb, var(--gmz-teal) 94%, transparent);
    color: var(--color-text-inverse);
    padding-block: var(--space-xs);
    font-size: var(--text-xs);
  }

  @media (width < 760px) {
    .home-hero {
      min-block-size: 38rem;
    }
    .home-hero__image {
      object-position: 58% center;
    }
    .home-hero__scrim {
      background: linear-gradient(
        180deg,
        color-mix(in srgb, var(--gmz-teal) 12%, transparent) 0%,
        color-mix(in srgb, var(--gmz-teal) 80%, transparent) 38%,
        color-mix(in srgb, var(--gmz-teal) 94%, transparent) 100%
      );
    }
    .home-hero__content {
      padding-block: 12rem var(--space-xl);
    }
  }
</style>
