---
/**
 * The request form: "Ask for something."
 *
 * One form for both clients. The garden client reaches it from the landing,
 * the project client from the project, and what changes is the kicker over
 * the title, the categories on offer and where the form posts. What is it
 * about, what would you like, a photo or two, and the line that says sending
 * is not an approval.
 *
 * The form posts to its own page, which keeps the request and redirects to
 * the receipt, with JavaScript or without it. If the request could not be
 * kept the page renders the form again with the error above it and nothing
 * the person typed lost; see `error`.
 *
 * On desktop the send block moves to the rail, which is why it renders twice:
 * once in the column with `column-only`, once in the rail with `rail`. The
 * send block sits after the form in both places, so both "Send it" buttons
 * submit the column's form by id, and there is still one form.
 */
import ScreenHead from '@components/portal/ScreenHead.astro';
import PhotoField from '@components/portal/PhotoField.astro';
import { primaryPhone } from '@data/site';
import { toSlug } from '../../server/screen';

interface Copy {
  categories: readonly string[];
  placeholder: string;
  disclaimer: string;
  urgent: string;
}

type Props =
  /** The form itself, in the column. */
  | {
      kicker: string;
      action: string;
      copy: Copy;
      /** What went wrong last time, if anything. Rendered above the form. */
      error?: string;
      /** What they had typed, so a failed send does not lose it. */
      previous?: { about?: string; what?: string };
      rail?: false;
    }
  /** The send block alone, for the desktop rail. It submits the column's form. */
  | {
      rail: true;
      copy: Copy;
      kicker?: undefined;
      action?: undefined;
      error?: undefined;
      previous?: undefined;
    };

/* Read through `props` rather than destructured, so `rail` narrows the union. */
const props = Astro.props;
const { copy } = props;

const formId = 'ask-form';
const checked = props.rail ? '' : (props.previous?.about ?? toSlug(copy.categories[0] ?? ''));
---

{
  !props.rail && (
    <>
      <ScreenHead kicker={props.kicker} title="Ask for something" long />

      <form
        class="block stack stack--lg"
        id={formId}
        action={props.action}
        method="post"
        enctype="multipart/form-data"
      >
        {props.error && (
          <p class="field__error" role="alert" id="ask-error">
            {props.error}
          </p>
        )}
        <fieldset class="group">
          <legend class="label">What is it about</legend>
          <div class="choices">
            {copy.categories.map((category) => (
              <label class="choice">
                <input
                  type="radio"
                  name="about"
                  value={toSlug(category)}
                  checked={toSlug(category) === checked}
                />
                <span>{category}</span>
              </label>
            ))}
          </div>
        </fieldset>

        <div class="field">
          <label class="label" for="ask-what">
            What would you like
          </label>
          <textarea
            id="ask-what"
            name="what"
            rows="5"
            placeholder={copy.placeholder}
            maxlength="4000"
            aria-describedby={props.error ? 'ask-error' : undefined}
            set:text={props.previous?.what ?? ''}
          />
        </div>

        <fieldset class="group">
          <legend class="label">Photos, if it helps</legend>
          <PhotoField name="photos" pair />
        </fieldset>
      </form>
    </>
  )
}

<div class:list={['send', props.rail ? 'send--rail' : ['block', 'block--end', 'column-only']]}>
  <p class="aside-note">{copy.disclaimer}</p>
  <div class="actions">
    <button class="btn btn--primary" type="submit" form={formId}> Send it </button>
    <a class="btn btn--secondary" href={`tel:${primaryPhone.tel}`}>Call instead</a>
  </div>
  <p class="note">{copy.urgent}</p>
</div>

<style>
  /* A fieldset is the right element for a set of choices; the browser's box
     around it is not. The min-width reset is what lets the chips wrap on a
     narrow phone. */
  .group {
    margin: 0;
    padding: 0;
    border: 0;
    min-inline-size: 0;
  }

  .group > legend {
    padding: 0 0 var(--space-xs);
  }

  .send {
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
  }

  /* In the column everything in the block sits one step apart, the two
     buttons included. */
  .send > .actions {
    gap: var(--space-sm);
  }

  /* In the rail the note stands apart from the buttons, and the buttons and
     the warning under them sit closer together. */
  .send--rail,
  .send--rail > .actions {
    gap: var(--space-xs);
  }

  .send--rail > .aside-note {
    margin-block-end: calc(var(--space-lg) - var(--space-xs));
  }
</style>
