---
/**
 * "Add a photo."
 *
 * A real file input with a real preview. The input carries the form's field
 * name, so a chosen photograph travels with the request as multipart data
 * and is re-encoded on the server before it is stored; see
 * `src/server/requests.ts`.
 *
 * The script also shrinks a large photograph before it is sent. A phone
 * photograph is several megabytes and the function that receives the form
 * will not read a body much over four, so anything over the server's ceiling
 * is redrawn at a smaller size and replaced in the input. The server still
 * re-encodes whatever arrives, so this is a courtesy to the upload, not the
 * thing that keeps metadata out. With JavaScript off it is still a working
 * file picker; the label just does not turn into a thumbnail, and a very
 * large photograph is refused with the reason.
 */
interface Props {
  /** The field name the server reads. Both slots of a pair share it. */
  name: string;
  label?: string;
  height?: number;
  /** Two slots side by side, as on the request form. */
  pair?: boolean;
}

const { name, label = 'Add a photo', height = 96, pair = false } = Astro.props;
const ids = pair ? [`${name}-1`, `${name}-2`] : [name];
---

<div class:list={['photos', { 'photos--pair': pair }]}>
  {
    ids.map((id) => (
      <label class="photos__slot" style={`min-height:${height}px`} data-photo-slot>
        <input type="file" id={id} name={name} accept="image/*" class="visually-hidden" />
        <span class="photos__label">{label}</span>
        <img class="photos__preview" alt="" hidden data-alt-set-by-script />
      </label>
    ))
  }
</div>

<script>
  /** The server's ceiling per photograph; see MAX_PHOTO_BYTES in src/server/requests.ts. */
  const CEILING = 2 * 1024 * 1024;
  /** Long edge after shrinking. Plenty for the crew to see what is meant. */
  const LONG_EDGE = 1800;

  // Redraw a photograph smaller until it fits under the ceiling. Returns the
  // original when it already fits, or when the browser cannot decode it.
  const shrink = async (file: File): Promise<File> => {
    if (file.size <= CEILING || !file.type.startsWith('image/')) return file;
    try {
      const bitmap = await createImageBitmap(file);
      const scale = Math.min(1, LONG_EDGE / Math.max(bitmap.width, bitmap.height));
      const canvas = document.createElement('canvas');
      canvas.width = Math.round(bitmap.width * scale);
      canvas.height = Math.round(bitmap.height * scale);
      canvas.getContext('2d')?.drawImage(bitmap, 0, 0, canvas.width, canvas.height);
      bitmap.close();
      for (const quality of [0.85, 0.7, 0.55]) {
        const blob = await new Promise<Blob | null>((resolve) =>
          canvas.toBlob(resolve, 'image/jpeg', quality),
        );
        if (blob && blob.size <= CEILING) {
          return new File([blob], file.name.replace(/\.[^.]+$/, '') + '.jpg', {
            type: 'image/jpeg',
          });
        }
      }
    } catch {
      /* Not decodable here; the server will say so. */
    }
    return file;
  };

  // Preview the chosen file inside its slot. Object URLs are revoked when
  // replaced so a client picking several photos in a row does not leak them.
  // Runs on first paint and after every client-side navigation, and the
  // `data-ready` guard keeps a slot from being wired twice.
  const initPhotoSlots = () =>
    document.querySelectorAll<HTMLLabelElement>('[data-photo-slot]').forEach((slot) => {
      const input = slot.querySelector<HTMLInputElement>('input[type=file]');
      const img = slot.querySelector<HTMLImageElement>('img');
      const label = slot.querySelector<HTMLElement>('.photos__label');
      if (!input || !img || !label || slot.dataset.ready) return;
      slot.dataset.ready = '1';
      let url: string | null = null;
      input.addEventListener('change', async () => {
        let file = input.files?.[0];
        if (url) URL.revokeObjectURL(url);
        if (!file) {
          img.hidden = true;
          label.hidden = false;
          slot.classList.remove('photos__slot--filled');
          return;
        }
        const smaller = await shrink(file);
        if (smaller !== file) {
          const transfer = new DataTransfer();
          transfer.items.add(smaller);
          input.files = transfer.files;
          file = smaller;
        }
        url = URL.createObjectURL(file);
        img.src = url;
        // The preview is the person's own photograph, so the alt says so. It is set
        // here rather than in the markup because until a file is chosen the image
        // is hidden and describes nothing.
        img.alt = 'The photo you chose';
        img.hidden = false;
        label.hidden = true;
        slot.classList.add('photos__slot--filled');
      });
    });

  initPhotoSlots();
  document.addEventListener('astro:page-load', initPhotoSlots);
</script>

<style>
  .photos {
    display: grid;
    gap: var(--space-xs);
  }

  .photos--pair {
    grid-template-columns: 1fr 1fr;
  }

  .photos__slot {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    border: 2px dashed var(--color-border);
    background: transparent;
    cursor: pointer;
    overflow: hidden;
  }

  .photos__slot--filled {
    border-style: solid;
    border-color: var(--color-border-strong);
  }

  .photos__slot:has(input:focus-visible) {
    outline: 2px solid var(--color-focus);
    outline-offset: 2px;
  }

  .photos__label {
    font-size: var(--text-sm);
    font-weight: 600;
    line-height: 1.2;
    color: var(--portal-action);
  }

  .photos__preview {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
</style>
