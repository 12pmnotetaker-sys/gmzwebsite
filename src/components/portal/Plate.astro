---
/**
 * A photo slot.
 *
 * With `src`, it is the photograph. Without one, it is a plate that says what
 * the photograph will be, in words, so an empty record still reads as a record
 * and nobody mistakes a grey box for a broken image.
 */
interface Props {
  src?: string;
  alt?: string;
  caption: string;
  height?: number;
  /** Full-bleed under the top bar, or inset to the column. */
  bleed?: boolean;
}

const { src, alt, caption, height = 170, bleed = false } = Astro.props;
---

{
  src ? (
    <figure class:list={['photo', { 'photo--bleed': bleed }]} style={`height:${height}px`}>
      <img src={src} alt={alt ?? caption} width="780" height={height * 2} loading="lazy" />
    </figure>
  ) : (
    <div class:list={['plate', { 'photo--bleed': bleed }]} style={`height:${height}px`}>
      <span>{caption}</span>
    </div>
  )
}

<style>
  .photo {
    background: var(--color-bg-well);
    overflow: hidden;
  }

  .photo img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* On a phone the band runs edge to edge under the top bar. */
  .photo--bleed {
    margin-inline: calc(-1 * var(--portal-gutter));
  }

  @media (min-width: 60rem) {
    .photo--bleed {
      margin-inline: 0;
    }
  }
</style>
