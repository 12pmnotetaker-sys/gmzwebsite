---
/**
 * A list row. A title, a note under it, and on the right either a chevron, an
 * action word, or a status chip. It is a link when it goes somewhere.
 *
 * The chevron is aria-hidden: the row's own words are the link, and an icon
 * never carries meaning on its own here.
 */
import StatusChip from '@components/portal/StatusChip.astro';
import type { StatusKey } from '@data/portal/status';

interface Props {
  href?: string;
  title: string;
  note?: string;
  /** Show a chip on the right instead of the chevron. */
  chip?: { tone: StatusKey; label: string };
  /** Show an uppercase action word on the right instead of the chevron. */
  action?: string;
}

const { href, title, note, chip, action } = Astro.props;
const Tag = href ? 'a' : 'div';
---

<Tag class="row" href={href}>
  <span class="row__text">
    <span class="row__title">{title}</span>
    {note && <span class="row__note">{note}</span>}
  </span>
  {
    chip ? (
      <StatusChip tone={chip.tone} label={chip.label} />
    ) : action ? (
      <span class="row__action">{action}</span>
    ) : href ? (
      <span class="row__go" aria-hidden="true">
        &rsaquo;
      </span>
    ) : null
  }
</Tag>
