---
import { company, primaryPhone } from '@data/site';
import {
  budgetBands,
  heardVia,
  honeypotField,
  limits,
  projectTypes,
  propertyTypes,
  timelines,
} from '@data/enquiry';

/**
 * The intake form.
 *
 * Every option list comes from `@data/enquiry`, which is the same module the
 * endpoint validates against, so the markup and the server cannot disagree
 * about what a valid answer is.
 *
 * Three behaviours are deliberate and worth keeping:
 *
 * 1. **A failed send never clears the form.** Someone who has just written
 *    four sentences about their garden should not lose them because a provider
 *    had a bad minute. On failure the panel offers the phone number and the
 *    fields stay exactly as they were.
 * 2. **The thank-you appears only on a 200 from the endpoint**, which itself
 *    returns 200 only when a delivery channel accepted the enquiry. There is
 *    no optimistic path.
 * 3. **Validation runs from the shared module**, not from a second set of
 *    rules written in the browser. A rule with two homes drifts.
 */
---

<form class="enquiry" method="post" action="/api/enquiry" novalidate data-enquiry-form>
  <div class="enquiry__summary" role="alert" tabindex="-1" hidden data-enquiry-summary></div>

  <fieldset class="enquiry__group">
    <legend class="enquiry__legend">Who you are</legend>

    <div class="field">
      <label class="field__label" for="name">Your name</label>
      <input
        class="field__input"
        id="name"
        name="name"
        type="text"
        maxlength={limits.name}
        autocomplete="name"
        required
      />
      <p class="field__error" id="name-error" hidden></p>
    </div>

    <div class="field-pair">
      <div class="field">
        <label class="field__label" for="email">Email</label>
        <input
          class="field__input"
          id="email"
          name="email"
          type="email"
          maxlength={limits.email}
          autocomplete="email"
          aria-describedby="reach-hint"
        />
        <p class="field__error" id="email-error" hidden></p>
      </div>

      <div class="field">
        <label class="field__label" for="phone">Phone</label>
        <input
          class="field__input"
          id="phone"
          name="phone"
          type="tel"
          maxlength={limits.phone}
          autocomplete="tel"
          aria-describedby="reach-hint"
        />
        <p class="field__error" id="phone-error" hidden></p>
      </div>
    </div>
    <p class="field__hint" id="reach-hint">Either one is enough. Whichever you prefer we use.</p>
  </fieldset>

  <fieldset class="enquiry__group">
    <legend class="enquiry__legend">The property</legend>

    <div class="field">
      <label class="field__label" for="town">Town</label>
      <input
        class="field__input"
        id="town"
        name="town"
        type="text"
        list="enquiry-towns"
        maxlength={limits.town}
        autocomplete="address-level2"
        aria-describedby="town-hint"
        required
      />
      <datalist id="enquiry-towns">
        {company.serviceArea.map((town) => <option value={town} />)}
      </datalist>
      <p class="field__hint" id="town-hint">
        The town is enough at this stage. The address comes later, once there is a visit to book.
      </p>
      <p class="field__error" id="town-error" hidden></p>
    </div>

    <div class="field">
      <label class="field__label" for="propertyType">What sort of property is it</label>
      <select class="field__input" id="propertyType" name="propertyType" required>
        <option value="">Choose one</option>
        {propertyTypes.map((choice) => <option value={choice.value}>{choice.label}</option>)}
      </select>
      <p class="field__error" id="propertyType-error" hidden></p>
    </div>
  </fieldset>

  <fieldset class="enquiry__group">
    <legend class="enquiry__legend">The work</legend>

    <div class="field">
      <label class="field__label" for="projectType">What are you thinking of</label>
      <select class="field__input" id="projectType" name="projectType" required>
        <option value="">Choose one</option>
        {projectTypes.map((choice) => <option value={choice.value}>{choice.label}</option>)}
      </select>
      <p class="field__error" id="projectType-error" hidden></p>
    </div>

    <div class="field">
      <label class="field__label" for="description">Tell us about it</label>
      <textarea
        class="field__input field__input--area"
        id="description"
        name="description"
        rows="6"
        maxlength={limits.description}
        aria-describedby="description-hint"
        required></textarea>
      <p class="field__hint" id="description-hint">
        In your own words. What you have now, what you would like instead, and anything that has
        already gone wrong. This is the part that tells us most.
      </p>
      <p class="field__error" id="description-error" hidden></p>
    </div>

    <div class="field-pair">
      <div class="field">
        <label class="field__label" for="timeline">When would you like it done</label>
        <select class="field__input" id="timeline" name="timeline" required>
          <option value="">Choose one</option>
          {timelines.map((choice) => <option value={choice.value}>{choice.label}</option>)}
        </select>
        <p class="field__error" id="timeline-error" hidden></p>
      </div>

      <div class="field">
        <label class="field__label" for="budget">
          What is your budget <span class="field__optional">optional</span>
        </label>
        <select class="field__input" id="budget" name="budget" aria-describedby="budget-hint">
          <option value="">Rather not say</option>
          {budgetBands.map((choice) => <option value={choice.value}>{choice.label}</option>)}
        </select>
        <p class="field__error" id="budget-error" hidden></p>
      </div>
    </div>
    <p class="field__hint" id="budget-hint">
      An honest range is the fastest way for us to tell you whether we are the right company for the
      job, which is better to know now than after a visit.
    </p>
  </fieldset>

  <fieldset class="enquiry__group">
    <legend class="enquiry__legend">Last two</legend>

    <div class="field">
      <label class="field__label" for="heardVia">
        How did you hear about GMZ <span class="field__optional">optional</span>
      </label>
      <select class="field__input" id="heardVia" name="heardVia">
        <option value="">Rather not say</option>
        {heardVia.map((choice) => <option value={choice.value}>{choice.label}</option>)}
      </select>
      <p class="field__error" id="heardVia-error" hidden></p>
    </div>

    <div class="field check">
      <input class="check__box" id="portfolio" name="portfolio" type="checkbox" />
      <label class="check__label" for="portfolio">
        I would like to see the private portfolio
      </label>
      <p class="field__hint check__hint">
        Finished gardens, the drawings behind them and walkthrough film. It sits behind a code, and
        the code comes with the consultation rather than with the enquiry.
      </p>
    </div>
  </fieldset>

  {
    /*
     * The honeypot. Hidden from sight and from assistive technology, skipped
     * by the keyboard, and never autofilled. A person cannot reach it; a
     * script fills it in because it looks like a field worth filling in.
     */
  }
  <div class="enquiry__trap" aria-hidden="true">
    <label for={honeypotField}>Company website</label>
    <input id={honeypotField} name={honeypotField} type="text" tabindex="-1" autocomplete="off" />
  </div>

  <div class="enquiry__actions">
    <button class="btn btn--primary" type="submit" data-enquiry-submit>Send this to GMZ</button>
    <p class="enquiry__small">
      No obligation, and nothing is charged until a visit is booked and you have agreed to it.
    </p>
  </div>

  <noscript>
    <p class="enquiry__noscript">
      This form needs JavaScript to send. Without it, please call
      {' '}<a href={`tel:${primaryPhone.tel}`}>{primaryPhone.display}</a> or email
      {' '}<a href={`mailto:${company.email}`}>{company.email}</a>.
    </p>
  </noscript>
</form>

<div
  class="outcome"
  role="status"
  aria-live="polite"
  hidden
  data-enquiry-outcome
  data-phone={primaryPhone.display}
  data-phone-tel={primaryPhone.tel}
>
</div>

<script>
  import { validate } from '@data/enquiry';

  const form = document.querySelector<HTMLFormElement>('[data-enquiry-form]');
  const summary = document.querySelector<HTMLElement>('[data-enquiry-summary]');
  const outcome = document.querySelector<HTMLElement>('[data-enquiry-outcome]');
  const submit = document.querySelector<HTMLButtonElement>('[data-enquiry-submit]');

  if (form && summary && outcome && submit) {
    const fieldError = (name: string) =>
      document.getElementById(`${name}-error`) as HTMLElement | null;

    const clearErrors = () => {
      summary.hidden = true;
      summary.textContent = '';
      form.querySelectorAll<HTMLElement>('.field__error').forEach((node) => {
        node.hidden = true;
        node.textContent = '';
      });
      form.querySelectorAll<HTMLElement>('[aria-invalid]').forEach((node) => {
        node.removeAttribute('aria-invalid');
      });
    };

    const showErrors = (errors: Record<string, string>) => {
      clearErrors();
      const names = Object.keys(errors);

      for (const name of names) {
        const node = fieldError(name);
        const input = form.elements.namedItem(name);
        if (node) {
          node.textContent = errors[name] ?? '';
          node.hidden = false;
        }
        if (input instanceof HTMLElement) {
          input.setAttribute('aria-invalid', 'true');
          // Point the input at its own message so a screen reader reads the
          // reason on focus, not just the fact that something is wrong.
          const described = input.getAttribute('aria-describedby');
          const id = `${name}-error`;
          if (!described?.includes(id)) {
            input.setAttribute('aria-describedby', described ? `${described} ${id}` : id);
          }
        }
      }

      summary.textContent =
        names.length === 1
          ? 'One answer needs another look before this can send.'
          : `${names.length} answers need another look before this can send.`;
      summary.hidden = false;

      const first = form.elements.namedItem(names[0] ?? '');
      if (first instanceof HTMLElement) first.focus();
    };

    /*
     * A failure panel, not a replacement. The form stays on the page with
     * everything the visitor typed still in it, because the most likely next
     * thing they do is try again or pick up the phone, and both are worse if
     * their words are gone.
     */
    const showFailure = (message: string) => {
      outcome.hidden = false;
      outcome.dataset.tone = 'error';
      outcome.innerHTML = '';

      const paragraph = document.createElement('p');
      paragraph.textContent = message;
      paragraph.tabIndex = -1;

      // The number is the whole point of this panel, so it is a link rather
      // than a sentence telling someone to go and find one.
      const call = document.createElement('p');
      const link = document.createElement('a');
      link.className = 'link-accent';
      link.href = `tel:${outcome.dataset.phoneTel ?? ''}`;
      link.textContent = `Call ${outcome.dataset.phone ?? ''}`;
      call.append(link);

      outcome.append(paragraph, call);
      paragraph.focus();
      outcome.scrollIntoView({ behavior: 'smooth', block: 'center' });
    };

    const showThanks = () => {
      form.hidden = true;
      outcome.hidden = false;
      outcome.dataset.tone = 'ok';
      outcome.innerHTML = '';

      const heading = document.createElement('h2');
      heading.className = 'outcome__title';
      heading.textContent = 'That reached us.';

      const body = document.createElement('p');
      body.textContent =
        'Someone will read it and come back to you. If you asked to see the portfolio, the code ' +
        'comes with the consultation, so it will arrive with the visit rather than by return.';

      outcome.append(heading, body);
      heading.tabIndex = -1;
      heading.focus();
      outcome.scrollIntoView({ behavior: 'smooth', block: 'center' });
    };

    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      if (submit.disabled) return;

      const data = Object.fromEntries(new FormData(form).entries());
      const checked = validate(data as Record<string, unknown>);
      if (!checked.ok) {
        showErrors(checked.errors);
        return;
      }

      clearErrors();
      outcome.hidden = true;
      submit.disabled = true;
      submit.textContent = 'Sending';

      try {
        const response = await fetch(form.action, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(data),
        });

        if (response.ok) {
          showThanks();
          return;
        }

        if (response.status === 422) {
          const payload = (await response.json()) as { fields?: Record<string, string> };
          showErrors(payload.fields ?? {});
          return;
        }

        /*
         * Everything else is a delivery failure, and the endpoint only ever
         * reports one when it means it. Say so plainly rather than dressing it
         * up: a visitor who thinks it sent will wait, and waiting is the
         * expensive outcome.
         */
        showFailure(
          'This did not send, and we would rather say so than let you wait on a reply that is ' +
            'not coming. Nothing you typed has been lost.',
        );
      } catch {
        showFailure(
          'This did not send, most likely a connection problem at one end or the other. Nothing ' +
            'you typed has been lost, so trying again in a moment costs nothing.',
        );
      } finally {
        submit.disabled = false;
        submit.textContent = 'Send this to GMZ';
      }
    });
  }
</script>

<style>
  .enquiry {
    max-inline-size: var(--width-prose);
  }

  .enquiry__group {
    border: none;
    border-block-start: var(--rule-structure) solid var(--color-structure);
    margin: 0;
    padding: var(--space-md) 0 0;
  }

  .enquiry__group + .enquiry__group {
    margin-block-start: var(--space-xl);
  }

  .enquiry__legend {
    padding: 0;
    font-size: var(--text-sm);
    font-weight: 600;
    letter-spacing: var(--tracking-kicker);
    text-transform: uppercase;
    color: var(--color-structure);
  }

  .field + .field,
  .field-pair + .field,
  .field + .field-pair,
  .field-pair + .field-pair {
    margin-block-start: var(--space-md);
  }

  /*
   * Inside a pair the two fields are side by side, so the stacking margin the
   * rule above gives every following field would push the right-hand one down
   * by itself. It did, and the labels sat on different lines.
   */
  .field-pair > .field + .field {
    margin-block-start: 0;
  }

  .field-pair {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-md);
  }

  .field__label {
    display: block;
    font-weight: 600;
    letter-spacing: var(--tracking-heading);
  }

  .field__optional {
    font-weight: 400;
    font-size: var(--text-sm);
    text-transform: uppercase;
    letter-spacing: var(--tracking-label);
    color: var(--color-text-muted);
  }

  .field__input {
    display: block;
    inline-size: 100%;
    margin-block-start: 0.375rem;
    font-family: var(--font-body);
    font-size: var(--text-base);
    color: var(--color-text);
    background: var(--color-bg);
    border: 1px solid var(--color-border-strong);
    border-radius: 0;
    padding: 0.75rem 0.875rem;
    transition: border-color var(--transition);
  }

  .field__input:focus-visible {
    border-color: var(--color-accent);
  }

  .field__input[aria-invalid='true'] {
    border-color: var(--color-highlight);
    border-inline-start-width: var(--rule-accent);
  }

  .field__input--area {
    resize: vertical;
    line-height: var(--leading-normal);
  }

  .field__hint {
    margin-block-start: 0.375rem;
    font-size: var(--text-sm);
    color: var(--color-text-muted);
  }

  .field__error {
    margin-block-start: 0.375rem;
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--color-text);
    border-inline-start: var(--rule-accent) solid var(--color-highlight);
    padding-inline-start: 0.625rem;
  }

  .check {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 0.25rem 0.625rem;
    align-items: start;
  }

  .check__box {
    inline-size: 1.125rem;
    block-size: 1.125rem;
    margin-block-start: 0.1875rem;
    accent-color: var(--color-accent);
  }

  .check__label {
    font-weight: 600;
    letter-spacing: var(--tracking-heading);
  }

  .check__hint {
    grid-column: 2;
    margin-block-start: 0;
  }

  /*
   * Off-screen rather than display:none. A field that is not rendered at all
   * is one a script can notice and skip; one that is merely out of sight
   * still looks like part of the form to whatever is filling it in.
   */
  .enquiry__trap {
    position: absolute;
    inline-size: 1px;
    block-size: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }

  .enquiry__summary {
    margin-block-end: var(--space-md);
    font-weight: 600;
    border-inline-start: var(--rule-accent) solid var(--color-highlight);
    padding: 0.625rem 0 0.625rem 0.875rem;
  }

  .enquiry__actions {
    margin-block-start: var(--space-xl);
    border-block-start: var(--rule-structure) solid var(--color-structure);
    padding-block-start: var(--space-md);
  }

  .enquiry__small,
  .enquiry__noscript {
    margin-block-start: var(--space-md);
    font-size: var(--text-sm);
    color: var(--color-text-muted);
  }

  .outcome {
    max-inline-size: var(--width-prose);
    border-block-start: var(--rule-structure) solid var(--color-structure);
    padding-block-start: var(--space-md);
  }

  .outcome[data-tone='error'] {
    border-block-start-color: var(--color-highlight);
  }

  .outcome__title {
    margin: 0;
    font-size: var(--text-2xl);
    letter-spacing: var(--tracking-heading);
  }

  .outcome p {
    margin-block-start: 0.5rem;
    color: var(--color-text-muted);
  }

  @media (width < 760px) {
    .field-pair {
      grid-template-columns: 1fr;
    }
  }
</style>
