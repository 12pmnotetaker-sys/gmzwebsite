---
import { formatReviewed, type Review } from '@data/reviews';

/**
 * Approved reviews, each linked back to where it was written.
 *
 * The same list serves /reviews and a project page, so a review reads the same
 * in both places: the words, who said them and where a reader can check.
 */
interface Props {
  reviews: Review[];
}

const { reviews } = Astro.props;
---

<ul class="reviews">
  {
    reviews.map((review) => (
      <li class="review">
        <blockquote class="review__quote">
          <p>{review.data.quote}</p>
        </blockquote>
        <p class="review__by">
          <span class="review__author">{review.data.author}</span>
          {review.data.location && <span>, {review.data.location}</span>}
          <span class="review__meta">
            {review.data.platform === 'Direct' ? (
              <>Written to GMZ, {formatReviewed(review.data.reviewed)}</>
            ) : (
              <>
                <a href={review.data.sourceUrl} rel="noopener noreferrer" target="_blank">
                  {review.data.platform}
                </a>
                , {formatReviewed(review.data.reviewed)}
              </>
            )}
          </span>
        </p>
      </li>
    ))
  }
</ul>

<style>
  .reviews {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-lg);
    max-inline-size: var(--width-prose);
  }

  .review {
    border-block-start: 2px solid var(--color-structure);
    padding-block-start: 1rem;
  }

  .review__quote {
    margin: 0;
    font-size: var(--text-lg);
    line-height: 1.6;
  }

  .review__by {
    margin-block-start: 0.75rem;
    color: var(--color-text-muted);
  }

  .review__author {
    font-weight: 600;
    color: var(--color-text);
  }

  .review__meta {
    display: block;
    margin-block-start: 0.25rem;
    font-size: var(--text-sm);
    letter-spacing: var(--tracking-kicker);
    text-transform: uppercase;
  }
</style>
